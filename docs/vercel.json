{
  "framework": "nextjs",
  "buildCommand": "cd docs && npm run build",
  "outputDirectory": "docs/.next",
  "installCommand": "cd docs && npm install",
  "devCommand": "cd docs && npm run dev",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "api_docs": true
    }
  }
}