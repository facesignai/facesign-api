d: true,\n          description: 'I agree to the Terms of Service'\n        },\n        {\n          key: 'marketing_consent',\n          isRequired: false,\n          description: 'I agree to receive marketing communications'\n        }\n      ]\n    }\n  ]\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$6"}],"title":"Advanced module configuration"}],"\n",["$","$L2",null,{"level":2,"id":"common-module-combinations","children":"Common module combinations"}],"\n",["$","h3",null,{"children":"Basic identity verification"}],"\n",["$","p",null,{"children":"Perfect for user onboarding and account verification:"}],"\n",["$","$L4",null,{"language":"typescript","code":"const basicIdentityModules = [\n  { type: 'emailVerification' },\n  { type: 'identityVerification' }\n];\n","children":["$","$L3",null,{"className":"language-typescript","children":"$7"}],"title":"Basic identity flow"}],"\n",["$","h3",null,{"children":"Financial services KYC"}],"\n",["$","p",null,{"children":"Comprehensive verification for financial applications:"}],"\n",["$","$L4",null,{"language":"typescript","code":"const kycModules = [\n  { type: 'emailVerification' },\n  { type: 'smsVerification' },\n  { type: 'identityVerification' },\n  { type: 'documentAuthentication' },\n  { \n    type: 'proofOfIntent',\n    requestedData: [\n      {\n        key: 'kyc_consent',\n        isRequired: true,\n        description: 'I consent to identity verification as required by law'\n      }\n    ]\n  }\n];\n","children":["$","$L3",null,{"className":"language-typescript","children":"$8"}],"title":"Financial KYC flow"}],"\n",["$","h3",null,{"children":"Age-restricted services"}],"\n",["$","p",null,{"children":"For platforms requiring age verification:"}],"\n",["$","$L4",null,{"language":"typescript","code":"const ageVerificationModules = [\n  { type: 'emailVerification' },\n  {\n    type: 'ageEstimation',\n    age: 21 // Must be 21 or older\n  },\n  { type: 'documentAuthentication' }, // Backup verification\n  {\n    type: 'proofOfIntent',\n    requestedData: [\n      {\n        key: 'age_verification_consent',\n        isRequired: true,\n        description: 'I confirm that I am of legal age to use this service'\n      }\n    ]\n  }\n];\n","children":["$","$L3",null,{"className":"language-typescript","children":"$9"}],"title":"Age verification flow"}],"\n",["$","h3",null,{"children":"High-security applications"}],"\n",["$","p",null,{"children":"Maximum security for sensitive applications:"}],"\n",["$","$L4",null,{"language":"typescript","code":"const highSecurityModules = [\n  { type: 'emailVerification' },\n  { type: 'smsVerification' },\n  { type: 'identityVerification' },\n  { type: 'documentAuthentication' },\n  { type: 'knowledgeVerify' },\n  {\n    type: 'proofOfIntent',\n    requestedData: [\n      {\n        key: 'security_acknowledgment',\n        isRequired: true,\n        description: 'I understand this is a high-security verification process'\n      }\n    ]\n  }\n];\n","children":["$","$L3",null,{"className":"language-typescript","children":"$a"}],"title":"High-security flow"}],"\n",["$","h3",null,{"children":"Quick social verification"}],"\n",["$","p",null,{"children":"Lightweight verification for social platforms:"}],"\n",["$","$L4",null,{"language":"typescript","code":"const socialVerificationModules = [\n  { type: 'emailVerification' },\n  {\n    type: 'ageEstimation',\n    age: 13 // COPPA compliance\n  }\n];\n","children":["$","$L3",null,{"className":"language-typescript","children":"$b"}],"title":"Social platform flow"}],"\n",["$","$L2",null,{"level":2,"id":"dynamic-module-selection","children":"Dynamic module selection"}],"\n",["$","h3",null,{"children":"User-based module selection"}],"\n",["$","p",null,{"children":"Choose modules based on user characteristics:"}],"\n",["$","$L4",null,{"language":"typescript","code":"async function selectModulesForUser(userId: string, verificationLevel: 'basic' | 'standard' | 'premium') {\n  const user = await db.users.findUnique({ where: { id: userId } });\n  \n  const baseModules = [{ type: 'emailVerification' }];\n  \n  switch (verificationLevel) {\n    case 'basic':\n      return baseModules;\n      \n    case 'standard':\n      return [\n        ...baseModules,\n        { type: 'identityVerification' }\n      ];\n      \n    case 'premium':\n      return [\n        ...baseModules,\n        { type: 'smsVerification' },\n        { type: 'identityVerification' },\n        { type: 'documentAuthentication' }\n      ];\n  }\n}\n\nasync function createAdaptiveSession(userId: string, verificationLevel: string) {\n  const modules = await selectModulesForUser(userId, verificationLevel);\n  \n  return client.sessions.create({\n    clientReferenceId: userId,\n    modules,\n    metadata: {\n      verificationLevel,\n      userId\n    }\n  });\n}\n","children":["$","$L3",null,{"className":"language-typescript","children":"$c"}],"title":"Dynamic module selection"}],"\n",["$","h3",null,{"children":"Risk-based module selection"}],"\n",["$","p",null,{"children":"Adjust verification requirements based on risk assessment:"}],"\n",["$","$L4",null,{"language":"typescript","code":"$d","children":["$","$L3",null,{"className":"language-typescript","children":"$e"}],"title":"Risk-based verification"}],"\n",["$","$L2",null,{"level":2,"id":"module-sequencing","children":"Module sequencing"}],"\n",["$","h3",null,{"children":"Sequential vs. parallel verification"}],"\n",["$","p",null,{"children":"FaceSign automatically handles module sequencing for optimal user experience:"}],"\n",["$","$L4",null,{"language":"typescript","code":"// Sequential flow - one module at a time\nconst sequentialModules = [\n  { type: 'emailVerification' },    // Step 1: Verify email first\n  { type: 'smsVerification' },      // Step 2: Then SMS\n  { type: 'identityVerification' }  // Step 3: Finally biometric\n];\n\n// Parallel flow - multiple modules can be completed in any order\nconst flexibleModules = [\n  { type: 'emailVerification' },\n  { type: 'smsVerification' },\n  // These can be completed in any order\n];\n","children":["$","$L3",null,{"className":"language-typescript","children":"$f"}],"title":"Module flow patterns"}],"\n",["$","h3",null,{"children":"Conditional module activation"}],"\n",["$","p",null,{"children":"Use custom flows to activate modules based on previous results:"}],"\n",["$","$L4",null,{"language":"typescript","code":"$10","children":["$","$L3",null,{"className":"language-typescript","children":"$11"}],"title":"Conditional module flows"}],"\n",["$","$L2",null,{"level":2,"id":"module-results-and-data","children":"Module results and data"}],"\n",["$","h3",null,{"children":"Accessing verification results"}],"\n",["$","p",null,{"children":"Each module provides specific data in the session report:"}],"\n",["$","$L4",null,{"language":"typescript","code":"$12","children":["$","$L3",null,{"className":"language-typescript","children":"$13"}],"title":"Module result handling"}],"\n",["$","$L2",null,{"level":2,"id":"best-practices","children":"Best practices"}],"\n",["$","h3",null,{"children":"1. Start simple, add complexity gradually"}],"\n",["$","p",null,{"children":"Begin with basic modules and add more based on your needs:"}],"\n",["$","$L4",null,{"language":"typescript","code":"// Phase 1: Basic email verification\nconst phase1Modules = [{ type: 'emailVerification' }];\n\n// Phase 2: Add biometric verification\nconst phase2Modules = [\n  { type: 'emailVerification' },\n  { type: 'identityVerification' }\n];\n\n// Phase 3: Full verification suite\nconst phase3Modules = [\n  { type: 'emailVerification' },\n  { type: 'smsVerification' },\n  { type: 'identityVerification' },\n  { type: 'documentAuthentication' }\n];\n","children":["$","$L3",null,{"className":"language-typescript","children":"$14"}],"title":"Progressive module adoption"}],"\n",["$","h3",null,{"children":"2. Consider user experience"}],"\n",["$","p",null,{"children":"Balance security with user experience:"}],"\n",["$","$L4",null,{"language":"typescript","code":"// Good: Progressive verification\nconst userFriendlyFlow = [\n  { type: 'emailVerification' },     // Quick and familiar\n  { type: 'identityVerification' }   // Fast biometric check\n];\n\n// Avoid: Too many verification steps at once\nconst overwhelmingFlow = [\n  { type: 'emailVerification' },\n  { type: 'smsVerification' },\n  { type: 'identityVerification' },\n  { type: 'documentAuthentication' },\n  { type: 'knowledgeVerify' },\n  { type: 'ageEstimation' }\n]; // This may cause user abandonment\n","children":["$","$L3",null,{"className":"language-typescript","children":"$15"}],"title":"UX-optimized module selection"}],"\n",["$","h3",null,{"children":"3. Match modules to use case"}],"\n",["$","p",null,{"children":"Choose modules that make sense for your application:"}],"\n",["$","$L4",null,{"language":"typescript","code":"const USE_CASE_MODULES = {\n  social_media: [\n    { type: 'emailVerification' },\n    { type: 'ageEstimation', age: 13 }\n  ],\n  \n  dating_app: [\n    { type: 'emailVerification' },\n    { type: 'identityVerification' }, // Prevent catfishing\n    { type: 'ageEstimation', age: 18 }\n  ],\n  \n  financial_services: [\n    { type: 'emailVerification' },\n    { type: 'smsVerification' },\n    { type: 'identityVerification' },\n    { type: 'documentAuthentication' },\n    { type: 'proofOfIntent' }\n  ],\n  \n  gaming: [\n    { type: 'emailVerification' },\n    { type: 'ageEstimation', age: 13 }\n  ]\n};\n","children":["$","$L3",null,{"className":"language-typescript","children":"$16"}],"title":"Use case specific modules"}],"\n",["$","h3",null,{"children":"4. Handle module failures gracefully"}],"\n",["$","p",null,{"children":"Provide fallback options when modules fail:"}],"\n",["$","$L4",null,{"language":"typescript","code":"// If biometric verification fails, fall back to document verification\nconst fallbackFlow = {\n  primary: [\n    { type: 'emailVerificatio