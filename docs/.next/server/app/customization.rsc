0:["QPa4IBP4ZHPscwZ87pf0h",[[["",{"children":["customization",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["customization",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"prose max-w-4xl mx-auto p-8","children":[["$","h1",null,{"children":"Session Customization"}],["$","div",null,{"className":"lead text-lg mb-8","children":"Tailor the FaceSign verification experience to match your brand and user experience requirements. Customize colors, fonts, messaging, and UI behavior to create a seamless integration."}],["$","h2",null,{"children":"Overview"}],["$","p",null,{"children":"Session customization allows you to control various aspects of the verification interface to match your application's look and feel. Customizations are applied when creating a session and affect the entire user journey."}],["$","h2",null,{"children":"Customization Options"}],["$","h3",null,{"children":"Branding"}],["$","p",null,{"children":"Customize the visual appearance to match your brand:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Primary Color"}]," - Main brand color used for buttons and highlights"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Secondary Color"}]," - Accent color for secondary elements"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Logo URL"}]," - Your company logo displayed during verification"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Background Color"}]," - Overall background color"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Text Color"}]," - Primary text color"]}]]}],["$","h3",null,{"children":"UI Controls"}],["$","p",null,{"children":"Control which UI elements are shown or hidden:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Show Progress Bar"}]," - Display verification progress"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Show Skip Button"}]," - Allow users to skip optional steps"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Show Help Button"}]," - Display help/support options"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Allow Camera Switch"}]," - Let users switch between cameras"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Show Torch Button"}]," - Display flashlight toggle for document scanning"]}]]}],["$","h3",null,{"children":"Messaging"}],["$","p",null,{"children":"Customize text and instructions shown to users:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Welcome Message"}]," - Initial greeting text"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Completion Message"}]," - Success message after verification"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Error Messages"}]," - Custom error text for different scenarios"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Instruction Text"}]," - Step-by-step guidance for users"]}]]}],["$","h2",null,{"children":"Implementation"}],["$","p",null,{"children":"Include customization options when creating a session:"}],["$","pre",null,{"className":"bg-gray-100 p-4 rounded overflow-x-auto","children":["$","code",null,{"children":"const session = await client.sessions.create({\n  clientReferenceId: 'user-123',\n  metadata: { userId: '123' },\n  modules: [\n    { type: 'identityVerification' },\n    { type: 'documentAuthentication' }\n  ],\n  customization: {\n    branding: {\n      primaryColor: '#007bff',\n      secondaryColor: '#6c757d',\n      logoUrl: 'https://your-domain.com/logo.png',\n      backgroundColor: '#ffffff',\n      textColor: '#333333'\n    },\n    ui: {\n      showProgressBar: true,\n      showSkipButton: false,\n      showHelpButton: true,\n      allowCameraSwitch: true,\n      showTorchButton: true\n    },\n    messaging: {\n      welcomeMessage: 'Welcome to our secure verification process',\n      completionMessage: 'Verification completed successfully!',\n      errorMessages: {\n        cameraPermission: 'Please allow camera access to continue',\n        networkError: 'Connection error. Please check your internet.'\n      }\n    }\n  }\n})"}]}],["$","h2",null,{"children":"Advanced Customization"}],["$","h3",null,{"children":"Custom CSS"}],["$","p",null,{"children":"For advanced styling, you can inject custom CSS:"}],["$","pre",null,{"className":"bg-gray-100 p-4 rounded overflow-x-auto","children":["$","code",null,{"children":"customization: {\n  css: `\n    .facesign-container {\n      font-family: 'Your Custom Font', sans-serif;\n      border-radius: 12px;\n    }\n    .facesign-button {\n      box-shadow: 0 4px 8px rgba(0,0,0,0.1);\n    }\n  `\n}"}]}],["$","h3",null,{"children":"Responsive Design"}],["$","p",null,{"children":"Customize appearance for different screen sizes:"}],["$","pre",null,{"className":"bg-gray-100 p-4 rounded overflow-x-auto","children":["$","code",null,{"children":"customization: {\n  responsive: {\n    mobile: {\n      fontSize: '14px',\n      padding: '16px'\n    },\n    desktop: {\n      fontSize: '16px',\n      padding: '24px'\n    }\n  }\n}"}]}],["$","h2",null,{"children":"Best Practices"}],["$","ul",null,{"children":[["$","li",null,{"children":"Test customizations on different devices and browsers"}],["$","li",null,{"children":"Ensure sufficient color contrast for accessibility"}],["$","li",null,{"children":"Keep custom messages clear and actionable"}],["$","li",null,{"children":"Use high-quality logos and images"}],["$","li",null,{"children":"Consider your brand guidelines when choosing colors"}],["$","li",null,{"children":"Test with users to ensure the customized experience is intuitive"}]]}],["$","h2",null,{"children":"Examples"}],["$","h3",null,{"children":"Minimal Branding"}],["$","pre",null,{"className":"bg-gray-100 p-4 rounded overflow-x-auto","children":["$","code",null,{"children":"customization: {\n  branding: {\n    primaryColor: '#2563eb',\n    logoUrl: 'https://example.com/logo.svg'\n  }\n}"}]}],["$","h3",null,{"children":"Full Customization"}],["$","pre",null,{"className":"bg-gray-100 p-4 rounded overflow-x-auto","children":["$","code",null,{"children":"customization: {\n  branding: {\n    primaryColor: '#059669',\n    secondaryColor: '#d1fae5',\n    logoUrl: 'https://example.com/logo.svg',\n    backgroundColor: '#f9fafb',\n    textColor: '#111827'\n  },\n  ui: {\n    showProgressBar: true,\n    showHelpButton: true,\n    allowCameraSwitch: true\n  },\n  messaging: {\n    welcomeMessage: 'Let\\'s verify your identity securely',\n    completionMessage: 'All set! Your identity has been verified.'\n  }\n}"}]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","customization","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/d2a8e44549219b96.css","precedence":"next","crossOrigin":"$undefined"}]],"$L4"],null],null],["$L5",null]]]]
