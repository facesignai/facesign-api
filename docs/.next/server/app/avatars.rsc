an style=\"color: var(--shiki-token-function)\">curl</span><span style=\"color: var(--shiki-color-text)\"> </span><span style=\"color: var(--shiki-token-string)\">https://api.facesign.ai/avatars</span><span style=\"color: var(--shiki-color-text)\"> \\</span></span>\n<span><span style=\"color: var(--shiki-color-text)\">  </span><span style=\"color: var(--shiki-token-string)\">-H</span><span style=\"color: var(--shiki-color-text)\"> </span><span style=\"color: var(--shiki-token-string-expression)\">&quot;Authorization: Bearer fs_live_...&quot;</span></span>\n<span></span>"}],"title":"cURL"}],["$","$L5",null,{"language":"typescript","code":"const { avatars } = await client.avatars.list();\n\n// Use in session creation\nconst { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_123',\n  avatarId: avatars[0].id, // Select an avatar\n  modules: [{ type: 'identityVerification' }]\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$6"}],"title":"TypeScript"}],["$","$L5",null,{"language":"python","code":"avatars = client.avatars.list()\n\n// Use in session creation\nsession = client.sessions.create(\n    client_reference_id=\"user_123\",\n    avatar_id=avatars.avatars[0].id,\n    modules=[{\"type\": \"identityVerification\"}]\n)\n","children":["$","$L3",null,{"className":"language-python","children":"$7"}],"title":"Python"}]]}],["$","$L5",null,{"language":"json","code":"{\n  \"avatars\": [\n    {\n      \"id\": \"avatar_sarah_professional\",\n      \"name\": \"Sarah\",\n      \"gender\": \"female\",\n      \"imageUrl\": \"https://cdn.facesign.ai/avatars/sarah_professional.jpg\"\n    },\n    {\n      \"id\": \"avatar_james_friendly\",\n      \"name\": \"James\",\n      \"gender\": \"male\", \n      \"imageUrl\": \"https://cdn.facesign.ai/avatars/james_friendly.jpg\"\n    },\n    {\n      \"id\": \"avatar_maria_bilingual\",\n      \"name\": \"Maria\",\n      \"gender\": \"female\",\n      \"imageUrl\": \"https://cdn.facesign.ai/avatars/maria_bilingual.jpg\"\n    },\n    {\n      \"id\": \"avatar_alex_neutral\",\n      \"name\": \"Alex\",\n      \"gender\": \"unknown\",\n      \"imageUrl\": \"https://cdn.facesign.ai/avatars/alex_neutral.jpg\"\n    }\n  ]\n}\n","children":["$","$L3",null,{"className":"language-json","children":"$8"}],"title":"Response"}]]}]]}],"\n",["$","hr",null,{}],"\n",["$","$L2",null,{"level":2,"id":"choosing-the-right-avatar","children":"Choosing the right avatar"}],"\n",["$","h3",null,{"children":"Consider your audience"}],"\n",["$","p",null,{"children":"Different avatars work better for different use cases and audiences:"}],"\n",["$","$L5",null,{"language":"typescript","code":"const AVATAR_RECOMMENDATIONS = {\n  financial_services: {\n    avatarId: 'avatar_sarah_professional',\n    description: 'Professional, trustworthy appearance for banking and financial apps'\n  },\n  healthcare: {\n    avatarId: 'avatar_james_caring',\n    description: 'Warm, empathetic avatar for medical verification'\n  },\n  gaming: {\n    avatarId: 'avatar_alex_casual',\n    description: 'Casual, friendly avatar for gaming platforms'\n  },\n  enterprise: {\n    avatarId: 'avatar_david_corporate',\n    description: 'Business-appropriate avatar for B2B applications'\n  },\n  international: {\n    avatarId: 'avatar_maria_bilingual',\n    description: 'Multicultural avatar for global applications'\n  }\n};\n\nfunction selectAvatarForUseCase(useCase: string) {\n  return AVATAR_RECOMMENDATIONS[useCase] || AVATAR_RECOMMENDATIONS.enterprise;\n}\n","children":["$","$L3",null,{"className":"language-typescript","children":"$9"}],"title":"Avatar selection by use case"}],"\n",["$","h3",null,{"children":"Dynamic avatar selection"}],"\n",["$","p",null,{"children":"You can dynamically select avatars based on user preferences or demographics:"}],"\n",["$","$L5",null,{"language":"typescript","code":"async function selectPersonalizedAvatar(userId: string) {\n  // Get available avatars\n  const { avatars } = await client.avatars.list();\n  \n  // Get user preferences\n  const user = await db.users.findUnique({ where: { id: userId } });\n  \n  // Filter avatars based on user preferences\n  let preferredAvatars = avatars;\n  \n  if (user.preferredAvatarGender) {\n    preferredAvatars = avatars.filter(avatar => \n      avatar.gender === user.preferredAvatarGender || avatar.gender === 'unknown'\n    );\n  }\n  \n  // Default to first available avatar if no preferences match\n  return preferredAvatars[0] || avatars[0];\n}\n\nasync function createPersonalizedSession(userId: string) {\n  const selectedAvatar = await selectPersonalizedAvatar(userId);\n  \n  const { session, clientSecret } = await client.sessions.create({\n    clientReferenceId: userId,\n    avatarId: selectedAvatar.id,\n    modules: [{ type: 'identityVerification' }]\n  });\n  \n  return { session, clientSecret };\n}\n","children":["$","$L3",null,{"className":"language-typescript","children":"$a"}],"title":"Dynamic avatar selection"}],"\n",["$","$L2",null,{"level":2,"id":"avatar-customization","children":"Avatar customization"}],"\n",["$","h3",null,{"children":"Custom phrases"}],"\n",["$","p",null,{"children":"Customize how your avatar greets and concludes the verification:"}],"\n",["$","$L5",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_123',\n  avatarId: 'avatar_sarah_professional',\n  initialPhrase: `Hi there! I'm Sarah, and I'll be helping you verify your identity today. This process should only take a few minutes.`,\n  finalPhrase: `Perfect! Your verification is complete. Thank you for taking the time to secure your account.`,\n  modules: [{ type: 'identityVerification' }]\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$b"}],"title":"Custom avatar phrases"}],"\n",["$","h3",null,{"children":"Brand-specific customization"}],"\n",["$","p",null,{"children":"Adapt the avatar's messaging to match your brand:"}],"\n",["$","$L5",null,{"language":"typescript","code":"$c","children":["$","$L3",null,{"className":"language-typescript","children":"$d"}],"title":"Brand-specific avatar setup"}],"\n",["$","$L2",null,{"level":2,"id":"avatar-selection-ui","children":"Avatar selection UI"}],"\n",["$","h3",null,{"children":"Let users choose their avatar"}],"\n",["$","p",null,{"children":"Provide an avatar selection interface before starting verification:"}],"\n",["$","$L5",null,{"language":"typescript","code":"$e","children":["$","$L3",null,{"className":"language-typescript","children":"$f"}],"title":"Avatar selection component"}],"\n",["$","h3",null,{"children":"Preview avatar interactions"}],"\n",["$","p",null,{"children":"Show users what to expect from their chosen avatar:"}],"\n",["$","$L5",null,{"language":"typescript","code":"$10","children":["$","$L3",null,{"className":"language-typescript","children":"$11"}],"title":"Avatar preview component"}],"\n",["$","$L2",null,{"level":2,"id":"best-practices","children":"Best practices"}],"\n",["$","h3",null,{"children":"1. Match avatar to brand personality"}],"\n",["$","p",null,{"children":"Choose avatars that align with your brand's personality and values:"}],"\n",["$","$L5",null,{"language":"typescript","code":"const BRAND_AVATAR_MAPPING = {\n  // Professional, trustworthy brands\n  financial: ['avatar_sarah_professional', 'avatar_david_corporate'],\n  \n  // Friendly, approachable brands\n  consumer: ['avatar_james_friendly', 'avatar_emma_casual'],\n  \n  // Healthcare and sensitive applications\n  healthcare: ['avatar_dr_williams_caring', 'avatar_nurse_compassionate'],\n  \n  // International or diverse audiences\n  global: ['avatar_maria_bilingual', 'avatar_alex_neutral', 'avatar_sam_international']\n};\n\nfunction getRecommendedAvatars(brandCategory: string): string[] {\n  return BRAND_AVATAR_MAPPING[brandCategory] || BRAND_AVATAR_MAPPING.consumer;\n}\n","children":["$","$L3",null,{"className":"language-typescript","children":"$12"}],"title":"Brand-avatar alignment"}],"\n",["$","h3",null,{"children":"2. Consider cultural sensitivity"}],"\n",["$","p",null,{"children":"Be mindful of cultural preferences when selecting avatars for different markets:"}],"\n",["$","$L5",null,{"language":"typescript","code":"$13","children":["$","$L3",null,{"className":"language-typescript","children":"$14"}],"title":"Cultural avatar considerations"}],"\n",["$","h3",null,{"children":"3. Test avatar effectiveness"}],"\n",["$","p",null,{"children":"Monitor how different avatars perform with your users:"}],"\n",["$","$L5",null,{"language":"typescript","code":"$15","children":["$","$L3",null,{"className":"language-typescript","children":"$16"}],"title":"Avatar performance tracking"}],"\n",["$","h3",null,{"children":"4. Cache avatar data"}],"\n",["$","p",null,{"children":"Cache avatar information to improve performance:"}],"\n",["$","$L5",null,{"language":"typescript","code":"let cachedAvatars: Avatar[] | null = null;\nlet cacheTimestamp = 0;\nconst CACHE_DURATION = 60 * 60 * 1000; // 1 hour\n\nasync function getAvailableAvatars(): Promise<Avatar[]> {\n  const now = Date.now();\n  \n  // Return cached version if still valid\n  if (cachedAvatars && (now - cacheTimestamp) < CACHE_DURATION) {\n    return cachedAvatars;\n  }\n  \n  // Fetch fresh data\n  const { avatars } = await client.avatars.list();\n  cachedAvatars = avatars;\n  cacheTimestamp = now;\n  \n  return avatars;\n}\n","children":["$","$L3",null,{"className":"language-typescript","children":"$17"}],"title":"Avatar caching"}],"\n",["$","$L2",null,{"level":2,"id":"next-steps","children":"Next steps"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","$L18",null,{"href":"/sessions","children":"Sessions"}]," - Learn how to create sessions with avatar configuration"]}],"\n",["$","li",null,{"children":[["$","$L18",null,{"href":"/languages","children":"Languages"}]," - Configure multi-language support for your avatar