 scans their document","interactive":true,"nodes":[{"id":"start","type":"start","label":"Start","description":"Entry point for the verification flow"},{"id":"liveness","type":"liveness_detection","label":"Liveness Check","description":"AI-powered detection to ensure the user is a real, live person"},{"id":"document","type":"document_scan","label":"Document Scan","description":"Scan and extract data from government-issued ID documents"},{"id":"end","type":"end","label":"Complete","description":"Verification flow completed successfully"}],"edges":[{"id":"e1","source":"start","target":"liveness"},{"id":"e2","source":"liveness","target":"document","label":"live person detected"},{"id":"e3","source":"document","target":"end","label":"document verified"}]}],"\n",["$","p",null,{"children":"The corresponding JSON structure for this flow:"}],"\n",["$","$L4",null,{"language":"json","code":"{\n  \"nodes\": [\n    { \"id\": \"start\", \"type\": \"start\" },\n    { \n      \"id\": \"liveness\", \n      \"type\": \"liveness_detection\",\n      \"outcomes\": {\n        \"livenessDetected\": \"document\",\n        \"deepfakeDetected\": \"end\",\n        \"noFace\": \"end\"\n      }\n    },\n    {\n      \"id\": \"document\",\n      \"type\": \"document_scan\",\n      \"scanningMode\": \"SINGLE_SIDE\",\n      \"allowedDocumentTypes\": [\"MRTD_TYPE_PASSPORT\"],\n      \"outcomes\": {\n        \"scanSuccess\": \"end\",\n        \"userCancelled\": \"end\",\n        \"scanTimeout\": \"end\"\n      }\n    },\n    { \"id\": \"end\", \"type\": \"end\" }\n  ],\n  \"edges\": [\n    { \"id\": \"e1\", \"source\": \"start\", \"target\": \"liveness\" },\n    { \"id\": \"e2\", \"source\": \"liveness\", \"target\": \"document\" },\n    { \"id\": \"e3\", \"source\": \"liveness\", \"target\": \"end\" },\n    { \"id\": \"e4\", \"source\": \"document\", \"target\": \"end\" }\n  ]\n}\n","children":["$","$L5",null,{"className":"language-json","children":"$6"}],"title":"Basic Flow Structure"}],"\n",["$",