0:["QPa4IBP4ZHPscwZ87pf0h",[[["",{"children":["flows",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["flows",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"prose max-w-4xl mx-auto p-8","children":[["$","h1",null,{"children":"Custom Flows"}],["$","div",null,{"className":"lead text-lg mb-8","children":"Build sophisticated verification experiences with FaceSign's node-based flow system. Create conditional verification paths, implement complex business logic, and design user experiences that adapt to different scenarios."}],["$","h2",null,{"children":"Overview"}],["$","p",null,{"children":"While the verification modules provide a simple way to configure common verification patterns, custom flows give you complete control over the verification process. Flows are built using a node-graph system where:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Nodes"}]," define verification steps and actions"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Edges"}]," define the connections between nodes"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Outcomes"}]," determine which path to take based on results"]}]]}],["$","h2",null,{"children":"Flow Structure"}],["$","p",null,{"children":"A flow consists of two main components:"}],["$","h3",null,{"children":"Nodes Array"}],["$","p",null,{"children":"Each node represents a step in your verification process. Nodes have specific types and configurations that determine what happens at that step."}],["$","h3",null,{"children":"Edges Array"}],["$","p",null,{"children":"Edges connect nodes together, defining the possible paths through your flow based on outcomes and conditions."}],["$","h2",null,{"children":"Available Node Types"}],["$","p",null,{"children":"FaceSign supports 11 different node types for building flows:"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4 my-8","children":[["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"START"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Entry point for the flow"}]]}],["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"END"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Exit point for the flow"}]]}],["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"CONVERSATION"}],["$","p",null,{"className":"text-sm text-gray-600","children":"AI-powered conversational interactions"}]]}],["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"LIVENESS_DETECTION"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Detect if user is real person"}]]}],["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"ENTER_EMAIL"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Collect email address from user"}]]}],["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"DATA_VALIDATION"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Validate and process data"}]]}],["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"DOCUMENT_SCAN"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Scan and extract document data"}]]}],["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"RECOGNITION"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Facial recognition against database"}]]}],["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"FACE_SCAN"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Capture and analyze face images"}]]}],["$","div",null,{"className":"border rounded p-4","children":[["$","h4",null,{"className":"font-semibold","children":"TWO_FACTOR"}],["$","p",null,{"className":"text-sm text-gray-600","children":"Two-factor authentication via SMS/email"}]]}]]}],["$","h2",null,{"children":"Basic Flow Example"}],["$","pre",null,{"className":"bg-gray-100 p-4 rounded overflow-x-auto","children":["$","code",null,{"children":"const basicFlow = {\n  nodes: [\n    { id: 'start', type: 'start' },\n    { \n      id: 'liveness', \n      type: 'liveness_detection',\n      outcomes: {\n        livenessDetected: 'document',\n        deepfakeDetected: 'end',\n        noFace: 'end'\n      }\n    },\n    {\n      id: 'document',\n      type: 'document_scan',\n      scanningMode: 'SINGLE_SIDE',\n      allowedDocumentTypes: ['MRTD_TYPE_PASSPORT'],\n      outcomes: {\n        scanSuccess: 'end',\n        userCancelled: 'end',\n        scanTimeout: 'end'\n      }\n    },\n    { id: 'end', type: 'end' }\n  ],\n  edges: [\n    { id: 'e1', source: 'start', target: 'liveness' },\n    { id: 'e2', source: 'liveness', target: 'document' },\n    { id: 'e3', source: 'liveness', target: 'end' },\n    { id: 'e4', source: 'document', target: 'end' }\n  ]\n}"}]}],["$","h2",null,{"children":"Using Custom Flows"}],["$","p",null,{"children":"Include your custom flow in the session creation request:"}],["$","pre",null,{"className":"bg-gray-100 p-4 rounded overflow-x-auto","children":["$","code",null,{"children":"const session = await client.sessions.create({\n  clientReferenceId: 'user-123',\n  metadata: { userId: '123' },\n  flow: myCustomFlow,\n  // Don't include modules when using custom flows\n})"}]}],["$","h2",null,{"children":"Best Practices"}],["$","ul",null,{"children":[["$","li",null,{"children":"Always start with a START node and end with an END node"}],["$","li",null,{"children":"Ensure all possible outcome paths are connected"}],["$","li",null,{"children":"Test flows thoroughly with different scenarios"}],["$","li",null,{"children":"Use meaningful node IDs for easier debugging"}],["$","li",null,{"children":"Consider user experience when designing conditional paths"}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","flows","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/d2a8e44549219b96.css","precedence":"next","crossOrigin":"$undefined"}]],"$L4"],null],null],["$L5",null]]]]
