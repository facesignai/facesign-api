e implementations"}],"\n",["$","h3",null,{"children":"Basic SMS verification"}],"\n",["$","p",null,{"children":"A simple setup where the user is prompted to enter their phone number:"}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_123',\n  modules: [\n    { type: 'smsVerification' }\n  ]\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$5"}],"title":"Backend: Create session"}],"\n",["$","h3",null,{"children":"Pre-filled SMS verification"}],"\n",["$","p",null,{"children":"To streamline the process, pre-fill the user's phone number:"}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_123',\n  modules: [\n    {\n      type: 'smsVerification',\n      phone: '+14155552671'\n    }\n  ],\n  metadata: {\n    userId: 'user_123'\n  }\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$6"}],"title":"Backend: Create session with pre-filled data"}],"\n",["$","$L2",null,{"level":2,"id":"user-experience","children":"User experience"}],"\n",["$","h3",null,{"children":"Phone number entry"}],"\n",["$","p",null,{"children":"The interface includes a country code selector for easy and accurate phone number entry:"}],"\n",["$","p",null,{"children":["$","img",null,{"src":"https://cdn.facesign.ai/docs/sms-phone-entry.png","alt":"SMS phone number entry"}]}],"\n",["$","h3",null,{"children":"OTP entry"}],"\n",["$","p",null,{"children":"The user enters the OTP they received via text message:"}],"\n",["$","p",null,{"children":["$","img",null,{"src":"https://cdn.facesign.ai/docs/sms-otp-entry.png","alt":"SMS OTP entry"}]}],"\n",["$","h3",null,{"children":"OTP message template"}],"\n",["$","p",null,{"children":"The text message sent to the user is clear and concise:"}],"\n",["$","p",null,{"children":["$","img",null,{"src":"https://cdn.fa