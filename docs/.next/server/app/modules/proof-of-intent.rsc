Confirm a large financial transaction to prevent disputes."}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_456',\n  modules: [\n    {\n      type: 'proofOfIntent',\n      requestedData: [\n        {\n          key: 'transaction_confirmation',\n          description: 'Do you confirm that you want to transfer $10,000 to account number ending in 5678?',\n          isRequired: true\n        },\n        {\n          key: 'is_final_sale',\n          description: 'Do you understand that this transaction is final and cannot be reversed?',\n          isRequired: true\n        }\n      ]\n    }\n  ]\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$6"}],"title":"Backend: Create session for transaction confirmation"}],"\n",["$","$L2",null,{"level":2,"id":"user-experience","children":"User experience"}],"\n",["$","p",null,{"children":"The AI avatar presents each statement clearly, and the user responds verbally."}],"\n",["$","p",null,{"children":["$","img",null,{"src":"https://cdn.facesign.ai/docs/proof-of-intent-ux.gif","alt":"Proof of intent user experience"}]}],"\n",["$","$L2",null,{"level":2,"id":"handling-verification-results","children":"Handling verification results"}],"\n",["$","h3",null,{"children":"Webhook event"}],"\n",["$","p",null,{"language":"txt","children":["The ",["$","$L3",null,{"children":"session.completed"}]," webhook report contains the user's responses in the ",["$","$L3",null,{"children":"extractedData"}]," field. The video recording is also available for audit purposes."]}],"\n",["$","$L4",null,{"language":"json","code":"{\n  \"id\": \"evt_abc123\",\n  \"type\": \"session.completed\",\n  \"data\": {\n    \"session\": {\n      \"id\": \"fs_session_xyz789\",\n      \"status\": \"complete\",\n      \"report\": {\n        \"isVerified\": true, // True if all required statements were agreed to\n        \"videos\": {\n          \"userVideoUrl\": \"https://cdn.facesign.ai/videos/fs_session_xyz789.mp4\"\n        },\n        \"extractedData\": {\n          \"terms_of_service\": \"true\",\n          \"privacy_policy\": \"true\",\n          \"marketing_emails\": \"false\"\n        }\n      },\n      \"settings\": {\n        \"clientReferenceId\": \"user_123\"\n      }\n    }\n  }\n}\n","children":["$","$L3",null,{"className":"language-json","children":"$7"}],"title":"session.completed webhook payload"}],"\n",["$","h3",null,{"children":"Backend logic"}],"\n",["$","p",null,{"children":"Use the webhook to record the user's consent and proceed with the action they agreed to."}],"\n",["$","$L4",null,{"language":"typescript","code":"app.post('/webhooks/facesign', async (req, res) => {\n  const { type, data } = req.body;\n\n  if (type === 'session.completed' && data.session.report?.isVerified) {\n    const { session } = data;\n    const { report, settings } = session;\n    const { extractedData } = report;\n    const userId = settings.clientReferenceId;\n\n    if (extractedData?.terms_of_service === 'true' && extractedData?.privacy_policy === 'true') {\n      // Record consent in your database\n      await db.consent.create({\n        data: {\n          userId,\n          termsOfServiceVersion: 'v2.1',\n          privacyPolicyVersion: 'v1.8',\n          agreedAt: new Date(),\n          videoProofUrl: report.videos.userVideoUrl\n        }\n      });\n\n      // Activate the user's account\n      await activateUserAccount(userId);\n    }\n  }\n\n  res.status(200).send('OK');\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$8"}],"title":"Backend: Webhook handler"}],"\n",["$","$L2",null,{"level":2,"id":"best-practices","children":"Best practices"}],"\n",["$","h3",null,{"children":"1. Clear and concise statements"}],"\n",["$","p",null,{"children":"Phrase your statements as clear, unambiguous yes/no questions. Avoid legal jargon where possible."}],"\n",["$","h3",null,{"children":"2. Required vs. optional consent"}],"\n",["$","p",null,{"language":"txt","children":["Carefully distinguish between required agreements (like terms of service) and optional ones (like marketing consent) using the ",["$","$L3",null,{"children":"isRequired"}]," flag."]}],"\n",["$","h3",null,{"children":"3. Audit trail"}],"\n",["$","p",null,{"language":"txt","children":["Store the ",["$","$L3",null,{"children":"userVideoUrl"}]," from the session report as part of your audit trail. This provides irrefutable proof of consent."]}],"\n",["$","h3",null,{"children":"4. Combine with Identity Verification"}],"\n",["$","p",null,{"language":"txt","children":["For maximum legal protection, combine ",["$","$L3",null,{"children":"proofOfIntent"}]," with ",["$","$L3",null,{"children":"identityVerification"}]," and ",["$","$L3",null,{"children":"documentAuthentication"}]," to prove not only ",["$","em",null,{"children":"what"}]," was agreed to, but also ",["$","em",null,{"children":"who"}]," agreed to it."]}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_123',\n  modules: [\n    { type: 'identityVerification' },\n    { type: 'documentAuthentication' },\n    {\n      type: 'proofOfIntent',\n      requestedData: [\n        // ... your statements\n      ]\n    }\n  ]\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$9"}],"title":"Backend: High-assurance consent flow"}],"\n",["$","$L2",null,{"level":2,"id":"next-steps","children":"Next steps"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","$La",null,{"href":"/modules/identity-verification","children":"Identity Verification"}]," - Verify the identity of the person providing consent"]}],"\n",["$","li",null,{"children":[["$","$La",null,{"href":"/modules/knowledge-verify","children":"Knowledge Verify"}]," - Add knowledge-based questions for further assurance"]}],"\n",["$","li