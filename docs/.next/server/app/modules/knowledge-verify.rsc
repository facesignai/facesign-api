\n",["$","$L2",null,{"level":2,"id":"module-configuration","children":"Module configuration"}],"\n",["$","h3",null,{"children":"Properties"}],"\n",["$","div",null,{"className":"my-6","children":["$","ul",null,{"role":"list","className":"m-0 max-w-[calc(var(--container-lg)-(--spacing(8)))] list-none divide-y divide-zinc-900/5 p-0 dark:divide-white/5","children":["$","li",null,{"className":"m-0 px-0 py-4 first:pt-0 last:pb-0","children":["$","dl",null,{"className":"m-0 flex flex-wrap items-center gap-x-3 gap-y-2","children":[["$","dt",null,{"className":"sr-only","children":"Name"}],["$","dd",null,{"children":["$","code",null,{"children":"type"}]}],[["$","dt",null,{"className":"sr-only","children":"Type"}],["$","dd",null,{"className":"font-mono text-xs text-zinc-400 dark:text-zinc-500","children":"string"}]],["$","dt",null,{"className":"sr-only","children":"Description"}],["$","dd",null,{"className":"w-full flex-none [&>:first-child]:mt-0 [&>:last-child]:mb-0","children":["$","p",null,{"language":"txt","children":["Must be ",["$","$L3",null,{"children":"knowledgeVerify"}],"."]}]}]]}]}]}]}],"\n",["$","p",null,{"children":["$","em",null,{"children":"This module has no additional configuration properties. The questions are generated dynamically based on available data for the user being verified."}]}],"\n",["$","hr",null,{}],"\n",["$","$L2",null,{"level":2,"id":"example-implementation","children":"Example implementation"}],"\n",["$","h3",null,{"children":"Account recovery"}],"\n",["$","p",null,{"children":"Use KBA as a step in a secure account recovery flow."}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_123',\n  modules: [\n    { type: 'emailVerification' }, // First, verify email\n    { type: 'knowledgeVerify' }    // Then, ask KBA questions\n  ],\n  metadata: {\n    userId: 'user_123',\n    reason: 'account_recovery_password_reset'\n  }\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$5"}],"title":"Backend: Create session for account recovery"}],"\n",["$","h3",null,{"children":"Step-up authentication"}],"\n",["$","p",null,{"children":"Require KBA for high-risk actions like changing an address or adding a new payment method."}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_456',\n  modules: [\n    { type: 'knowledgeVerify' }\n  ],\n  metadata: {\n    userId: 'user_456',\n    reason: 'change_of_address_confirmation'\n  }\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$6"}],"title":"Backend: Create session for step-up auth"}],"\n",["$","$L2",null,{"level":2,"id":"user-experience","children":"User experience"}],"\n",["$","p",null,{"children":"The AI avatar presents a series of multiple-choice questions in a conversational manner."}],"\n",["$","p",null,{"children":["$","img",null,{"src":"https://cdn.facesign.ai/docs/kba-ux.png","alt":"Knowledge verify user experience"}]}],"\n",["$","$L2",null,{"level":2,"id":"handling-verification-results","children":"Handling verification results"}],"\n",["$","h3",null,{"children":"Webhook event"}],"\n",["$","p",null,{"language":"txt","children":["The ",["$","$L3",null,{"children":"session.completed"}]," webhook ",["$","$L3",null,{"children":"report.isVerified"}]," field will be ",["$","$L3",null,{"children":"true"}]," if the user answered enough questions correctly."]}],"\n",["$","$L4",null,{"language":"json","code":"{\n  \"id\": \"evt_abc123\",\n  \"type\": \"session.completed\",\n  \"data\": {\n    \"session\": {\n      \"id\": \"fs_session_xyz789\",\n      \"status\": \"complete\",\n      \"report\": {\n        \"isVerified\": true, // True if KBA was passed\n        \"livenessDetected\": false,\n        \"extractedData\": {\n          \"kba_passed\": \"true\",\n          \"kba_score\": \"0.8\" // e.g., 4 out of 5 questions correct\n        }\n      },\n      \"settings\": {\n        \"clientReferenceId\": \"user_123\"\n      }\n    }\n  }\n}\n","children":["$","$L3",null,{"className":"language-json","children":"$7"}],"title":"session.completed webhook payload"}],"\n",["$","h3",null,{"children":"Backend logic"}],"\n",["$","p",null,{"children":"Use the webhook to determine if the user passed the KBA check."}],"\n",["$","$L4",null,{"language":"typescript","code":"app.post('/webhooks/facesign', async (req, res) => {\n  const { type, data } = req.body;\n\n  if (type === 'session.completed') {\n    const { session } = data;\n    const { report, settings } = session;\n    const userId = settings.clientReferenceId;\n\n    const kbaModule = settings.modules.find(m => m.type === 'knowledgeVerify');\n    if (kbaModule) {\n      if (report?.isVerified) {\n        // KBA passed, allow the action\n        console.log(`KBA successful for user ${userId}`);\n        await completeAccountRecovery(userId);\n      } else {\n        // KBA failed, lock the account and notify support\n        console.log(`KBA failed for user ${userId}`);\n        await lockAccount(userId);\n        await notifySupportTeam(`KBA failure for user ${userId}`);\n      }\n    }\n  }\n\n  res.status(200).send('OK');\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$8"}],"title":"Backend: Webhook handler"}],"\n",["$","$L2",null,{"level":2,"id":"best-practices","children":"Best practices"}],"\n",["$","h3",null,{"children":"1. Use for step-up or recovery, not onboarding"}],"\n",["$","p",null,{"children":"KBA is most effective when you already have some information about the user. It is not recommended for initial onboarding of new, unknown users, as there may not be enough data to generate questions."}],"\n",["$","h3",null,{"children":"2. Combine with other factors"}],"\n",["$","p",null,{"language":"txt","children":["KBA is strongest when used as part of a multi-factor authentication flow. Combine it with ",["$","$L3",null,{"children":"emailVerification"}],", ",["$","$L3",null,{"children":"smsVerification"}],", or ",["$","$L3",null,{"children":"identityVerification"}],"."]}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_123',\n  modules: [\n    { type: 'smsVerification' },      // Something the user has\n    { type: 'knowledgeVerify' }     // Something the user knows\n  ]\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$9"}],"title":"Backend: Multi-factor recovery"}],"\n",["$","h3",null,{"children":"3. Dynamic KBA (D-KBA)"}],"\n",["$","p",null,{"children":"FaceSign uses dynamic KBA, meaning the questions are generated in real-time from a wide range of data sources. This is more secure than static KBA, which uses a fixed set of questions that could be compromised."}],"\n",["$","h3",null,{"children":"4. Handling \"I don't know\""}],"\n",["$","p",null,{"children":"The interface allows users to indicate if none of the answers are correct or if they don't know the answer. This is an important part of the process and helps prevent users from guessing."}],"\n",["$","$L2",null,{"level":2,"id":"next-steps","children":"Next steps"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","$La",null,{"href":"/modules/proof-of-intent","children":"Proof of Intent"}]," - Capture user consent for high-risk actions"]}],"\n",["$","li",null,{"children":[["$","$La",null,{"href":"/flows","children":"Custom Flows"}]," - Build custom account recovery and step-up authentication flows"]}],"\n",["$","li",null,{"children":[["$","$La",null,{"href":"/sessions","children":"Sessions"}]," - Learn more about session management and reports"]}],"\n"]}]]}],["$","footer",null,{"className":"mx-auto mt-16 w-full max-w-2xl lg:max-w-5xl","children":["$","$Lb",null,{}]}]]}],null],null],null]},[null,["$","$Lc",null,{"parallelRouterKey":"children","segmentPath