,null,{"children":"false"}]," result based on the required age."]}],"\n"]}],"\n",["$","$L2",null,{"level":2,"id":"module-configuration","children":"Module configuration"}],"\n",["$","h3",null,{"children":"Properties"}],"\n",["$","div",null,{"className":"my-6","children":["$","ul",null,{"role":"list","className":"m-0 max-w-[calc(var(--container-lg)-(--spacing(8)))] list-none divide-y divide-zinc-900/5 p-0 dark:divide-white/5","children":[["$","li",null,{"className":"m-0 px-0 py-4 first:pt-0 last:pb-0","children":["$","dl",null,{"className":"m-0 flex flex-wrap items-center gap-x-3 gap-y-2","children":[["$","dt",null,{"className":"sr-only","children":"Name"}],["$","dd",null,{"children":["$","code",null,{"children":"type"}]}],[["$","dt",null,{"className":"sr-only","children":"Type"}],["$","dd",null,{"className":"font-mono text-xs text-zinc-400 dark:text-zinc-500","children":"string"}]],["$","dt",null,{"className":"sr-only","children":"Description"}],["$","dd",null,{"className":"w-full flex-none [&>:first-child]:mt-0 [&>:last-child]:mb-0","children":["$","p",null,{"language":"txt","children":["Must be ",["$","$L3",null,{"children":"ageEstimation"}],"."]}]}]]}]}],["$","li",null,{"className":"m-0 px-0 py-4 first:pt-0 last:pb-0","children":["$","dl",null,{"className":"m-0 flex flex-wrap items-center gap-x-3 gap-y-2","children":[["$","dt",null,{"className":"sr-only","children":"Name"}],["$","dd",null,{"children":["$","code",null,{"children":"age"}]}],[["$","dt",null,{"className":"sr-only","children":"Type"}],["$","dd",null,{"className":"font-mono text-xs text-zinc-400 dark:text-zinc-500","children":"number"}]],["$","dt",null,{"className":"sr-only","children":"Description"}],["$","dd",null,{"className":"w-full flex-none [&>:first-child]:mt-0 [&>:last-child]:mb-0","children":["$","p",null,{"children":"The minimum required age for the verification to pass."}]}]]}]}]]}]}],"\n",["$","hr",null,{}],"\n",["$","$L2",null,{"level":2,"id":"example-implementation","children":"Example implementation"}],"\n",["$","h3",null,{"children":"Age verification for a gaming platform"}],"\n",["$","p",null,{"children":"Verify that users are at least 13 years old to comply with COPPA."}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_456',\n  modules: [\n    {\n      type: 'ageEstimation',\n      age: 13 // Minimum age required\n    }\n  ],\n  metadata: {\n    userId: 'user_456',\n    platform: 'gaming_site'\n  }\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$5"}],"title":"Backend: Create session for age verification"}],"\n",["$","h3",null,{"children":"Age verification for an 18+ service"}],"\n",["$","p",null,{"children":"Ensure users are over 18 for an age-restricted service."}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_789',\n  modules: [\n    {\n      type: 'ageEstimation',\n      age: 18 // Must be 18 or older\n    }\n  ],\n  metadata: {\n    userId: 'user_789',\n    service: 'online_dating'\n  }\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$6"}],"title":"Backend: Create session for 18+ service"}],"\n",["$","$L2",null,{"level":2,"id":"user-experience","children":"User experience"}],"\n",["$","p",null,{"children":"The user experience is fast and frictionless. The user simply looks at the camera for a few seconds."}],"\n",["$","p",null,{"children":["$","img",null,{"src":"https://cdn.facesign.ai/docs/age-estimation-ux.gif","alt":"Age estimation user experience"}]}],"\n",["$","$L2",null,{"level":2,"id":"handling-verification-results","children":"Handling verification results"}],"\n",["$","h3",null,{"children":"Webhook event"}],"\n",["$","p",null,{"language":"txt","children":["The ",["$","$L3",null,{"children":"session.completed"}]," webhook report contains the AI's analysis, including the estimated age range and the overall verification result."]}],"\n",["$","$L4",null,{"language":"json","code":"{\n  \"id\": \"evt_abc123\",\n  \"type\": \"session.completed\",\n  \"data\": {\n    \"session\": {\n      \"id\": \"fs_session_xyz789\",\n      \"status\": \"complete\",\n      \"report\": {\n        \"isVerified\": true, // True if estimated age is >= required age\n        \"livenessDetected\": true,\n        \"aiAnalysis\": {\n          \"ageMin\": 22,\n          \"ageMax\": 28,\n          \"sex\": \"male\",\n          \"realPersonOrVirtual\": \"real\",\n          \"overallSummary\": \"Age estimation successful. Estimated age is above the required threshold of 18.\"\n        }\n      },\n      \"settings\": {\n        \"clientReferenceId\": \"user_789\",\n        \"modules\": [\n          { \"type\": \"ageEstimation\", \"age\": 18 }\n        ]\n      }\n    }\n  }\n}\n","children":["$","$L3",null,{"className":"language-json","children":"$7"}],"title":"session.completed webhook payload"}],"\n",["$","h3",null,{"children":"Backend logic"}],"\n",["$","p",null,{"children":"Use the webhook to grant or deny access based on the age verification result."}],"\n",["$","$L4",null,{"language":"typescript","code":"app.post('/webhooks/facesign', async (req, res) => {\n  const { type, data } = req.body;\n\n  if (type === 'session.completed') {\n    const { session } = data;\n    const { report, settings } = session;\n    const userId = settings.clientReferenceId;\n\n    // Check if the age estimation module was part of the session\n    const ageModule = settings.modules.find(m => m.type === 'ageEstimation');\n    if (ageModule) {\n      if (report?.isVerified) {\n        // Age requirement met\n        await db.users.update({\n          where: { id: userId },\n          data: {\n            isAgeVerified: true,\n            ageRange: `${report.aiAnalysis.ageMin}-${report.aiAnalysis.ageMax}`\n          }\n        });\n        await grantAccessToService(userId);\n      } else {\n        // Age requirement not met\n        await db.users.update({\n          where: { id: userId },\n          data: { isAgeVerified: false }\n        });\n        await denyAccessToService(userId, 'Underage');\n      }\n    }\n  }\n\n  res.status(200).send('OK');\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$8"}],"title":"Backend: Webhook handler"}],"\n",["$","$L2",null,{"level":2,"id":"best-practices","children":"Best practices"}],"\n",["$","h3",null,{"children":"1. Privacy-first approach"}],"\n",["$","p",null,{"children":"Age Estimation is less intrusive than asking for an ID document. Position it as a quick, easy, and private way to verify age. No personal data is stored beyond the result of the check."}],"\n",["$","h3",null,{"children":"2. Provide fallback options"}],"\n",["$","p",null,{"language":"txt","children":["For users who are near the age threshold or who fail the estimation, provide a fallback method like ",["$","$L3",null,{"children":"documentAuthentication"}]," to ensure they are not unfairly blocked."]}],"\n",["$","$L4",null,{"language":"typescript","code":"// Use a custom flow for this logic\nconst ageVerificationFlow = {\n  nodes: [\n    {\n      id: 'age_estimation',\n      type: 'ageEstimation',\n      age: 18,\n      outcomes: {\n        success: 'end_success',\n        failure: 'document_auth_fallback' // If age check fails\n      }\n    },\n    {\n      id: 'document_auth_fallback',\n      type: 'documentAuthentication',\n      outcomes: {\n        success: 'end_success',\n        failure: 'end_failure'\n      }\n    }\n  ],\n  // ... edges configuration\n};\n","children":["$","$L3",null,{"className":"language-typescript","children":"$9"}],"title":"Backend: Flow with fallback"}],"\n",["$","h3",null,{"children":"3. Communicate results clearly"}],"\n",["$","p",null,{"children":"If a user fails the age check, provide a clear and helpful message. Avoid accusatory language. For example: \"Our system could not confirm you meet the age requirement. Please try verifying with a valid ID document.\""}],"\n",["$","h3",null,{"children":"4. Accuracy and bias"}],"\n",["$","p",null,{"children":"FaceSign's AI is trained on a diverse, global dataset to ensure high accuracy and minimize bias across different demographics. The system provides an age range to account for potential variations."}],"\n",["$","$L2",null,{"level":2,"id":"next-steps","children":"Next steps"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","$La",null,{"href":"/modules/document-authentication","children":"Document Authentication"}]," - Use as a fallback for age verification"]}],"\n",["$","li",null,{"children":[["$","$La",null,{"href":"/modules/identity-verification","children":"Identity Verification"}]," - Perform full biometric identity checks"]}],"\n",["$","li",null,{"children":[["$","$La",null,{"href":"/flows","children":"Custom Flows"}]," - Build advanced flows with conditional logic for age checks"]}],"\n"]}]]}],["$","footer",null,{"className":"mx-auto mt-16 w-full max-w-2xl lg:max-w-5xl","children":["$","$Lb",null,{}]}]]}],null],null],null]},[null,["$","$Lc",null,{"parallelRouterKey":"children","segmentPath":["children","modules","children","age-estimation","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$Lc",null,{"parallelRouterKey":"children","segmentPath":["children","modules","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Ld",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/d2a8e44549219b96.css","precedence":"next","crossOrigin":"$undefined"}]],"$Le"],null],n