{"children":"The user interacts with the AI avatar to prove they are a real person, present during the verification."}],"\n",["$","p",null,{"children":["$","img",null,{"src":"https://cdn.facesign.ai/docs/identity-liveness-check.gif","alt":"Identity verification liveness check"}]}],"\n",["$","h3",null,{"children":"Real-time feedback"}],"\n",["$","p",null,{"children":"The system provides real-time feedback to help the user position themselves correctly."}],"\n",["$","p",null,{"children":["$","img",null,{"src":"https://cdn.facesign.ai/docs/identity-real-time-feedback.png","alt":"Identity verification real-time feedback"}]}],"\n",["$","$L2",null,{"level":2,"id":"handling-verification-results","children":"Handling verification results"}],"\n",["$","h3",null,{"children":"Webhook event"}],"\n",["$","p",null,{"language":"txt","children":["The ",["$","$L3",null,{"children":"session.completed"}]," webhook contains detailed results in the ",["$","$L3",null,{"children":"report"}]," object."]}],"\n",["$","$L4",null,{"language":"json","code":"{\n  \"id\": \"evt_abc123\",\n  \"type\": \"session.completed\",\n  \"data\": {\n    \"session\": {\n      \"id\": \"fs_session_xyz789\",\n      \"status\": \"complete\",\n      \"report\": {\n        \"isVerified\": true,\n        \"livenessDetected\": true,\n        \"aiAnalysis\": {\n          \"ageMin\": 28,\n          \"ageMax\": 35,\n          \"sex\": \"female\",\n          \"realPersonOrVirtual\": \"real\",\n          \"overallSummary\": \"High confidence liveness detected. Biometric data matches reference.\"\n        }\n      },\n      \"settings\": {\n        \"clientReferenceId\": \"user_123\"\n      }\n    }\n  }\n}\n","children":["$","$L3",null,{"className":"language-json","children":"$6"}],"title":"session.completed webhook payload"}],"\n",["$","h3",null,{"children":"Backend logic"}],"\n",["$","p",null,{"children":"Use the webhook to assess the verification outcome and take appropriate action."}],"\n",["$","$L4",null,{"language":"typescript","code":"app.post('/webhooks/facesign', async (req, res) => {\n  const { type, data } = req.body;\n\n  if (type === 'session.completed') {\n    const { session } = data;\n    const { report, settings } = session;\n\n    const userId = settings.clientReferenceId;\n    const isVerified = report?.isVerified && report?.livenessDetected;\n\n    if (isVerified) {\n      // User is verified, grant access\n      await db.users.update({\n        where: { id: userId },\n        data: {\n          isVerified: true,\n          verifiedAt: new Date()\n        }\n      });\n      await grantFullAccess(userId);\n    } else {\n      // Verification failed, flag for manual review\n      await db.users.update({\n        where: { id: userId },\n        data: {\n          isVerified: false,\n          needsManualReview: true\n        }\n      });\n      await notifyAdminTeam(userId, 'Biometric verification failed');\n    }\n  }\n\n  res.status(200).send('OK');\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$7"}],"title":"Backend: Webhook handler"}],"\n",["$","$L2",null,{"level":2,"id":"best-practices","children":"Best practices"}],"\n",["$","h3",null,{"children":"1. Clear communication"}],"\n",["$","p",null,{"children":"Inform your users why they need to complete a biometric verification step. Explain the security benefits to build trust."}],"\n",["$","h3",null,{"children":"2. Combine with document authentication"}],"\n",["$","p",null,{"language":"txt","children":["For Know Your Customer (KYC) compliance, combine ",["$","$L3",null,{"children":"identityVerification"}]," with ",["$","$L3",null,{"children":"documentAuthentication"}]," to match the user's face to their government-issued ID."]}],"\n",["$","$L4",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: 'user_123',\n  modules: [\n    { type: 'identityVerification' },\n    { type: 'documentAuthentication' }\n  ]\n});\n","children":["$","$L3",null,{"className":"language-typescript","children":"$8"}],"title":"Backend: KYC flow"}],"\n",["$","h3",null,{"children":"3. Handling low-light conditions"}],"\n",["$","p",null,{"children":"FaceSign's AI is designed to work in various lighting conditions, but it's helpful to advise users to be in a well-lit area for the best results."}],"\n",["$","h3",null,{"children":"4. Deepfake and fraud prevention"}],"\n",["$","p",null,{"language":"txt","children":["This module is your first line of defense against deepfakes, presentation attacks (e.g., holding up a photo), and other forms of identity fraud. The ",["$","$L3",null,{"children":"livenessDetected"}]," and ",["$","$L3",null,{"children":"realPersonOrVirtual"}]," fields are critical for assessing this risk."]}],"\n",["$","$L2",null,{"level":2,"id":"next-steps","children":"Next steps"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","$L9",null,{"href":"/modules/document-authentication","children":"Document Authentication"}]," - Add ID document scanning and verification"]}],"\n",["$","li",null,{"children":[["$","$L9",null,{"href":"/modules/age-estimation","children":"Age Estimation"}]," - Verify user age with AI"]}],"\n",["$","li",null,{"children":[["$","$L9",null,{"href":"/flows","children":"Custom Flows"}]," - Build advanced flows with conditional logic"]}],"\n"]}]]}]}],null],null],null]},[null,["$","$La",null,{"parallelRouterKey":"children","segmentPath":["children","modules","children","identity-verification","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Lb",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$La",null,{"parallelRouterKey":"children","segmentPath":["children","modules","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$Lb",null,{}],"templateSt