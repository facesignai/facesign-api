rror') {\n    // Handle invalid parameters\n    console.error(`Invalid parameter: ${error.param}`);\n    console.error(`Error message: ${error.message}`);\n  } else if (error.type === 'authentication_error') {\n    // Handle authentication errors\n    console.error('Check your API key');\n  } else if (error.statusCode === 429) {\n    // Handle rate limiting\n    console.error('Rate limited. Retry after:', error.headers['retry-after']);\n  } else {\n    // Handle other errors\n    console.error('An unexpected error occurred:', error.message);\n  }\n}\n","children":["$","$L4",null,{"className":"language-typescript","children":"$7"}],"title":"TypeScript"}],["$","$L3",null,{"language":"python","code":"import facesign\nfrom facesign.error import (\n    FaceSignError,\n    InvalidRequestError,\n    AuthenticationError,\n    RateLimitError\n)\n\nfacesign.api_key = os.environ.get('FACESIGN_API_KEY')\n\ntry:\n    session = facesign.Session.create(\n        mode='redirect',\n        success_url='https://example.com/success',\n        cancel_url='https://example.com/cancel'\n    )\nexcept InvalidRequestError as e:\n    # Handle invalid parameters\n    print(f\"Invalid parameter: {e.param}\")\n    print(f\"Error message: {e.user_message}\")\nexcept AuthenticationError as e:\n    # Handle authentication errors\n    print(\"Check your API key\")\nexcept RateLimitError as e:\n    # Handle rate limiting\n    print(f\"Rate limited. Retry after: {e.headers.get('retry-after')}\")\nexcept FaceSignError as e:\n    # Handle other FaceSign errors\n    print(f\"FaceSign error: {e.user_message}\")\nexcept Exception as e:\n    # Handle other errors\n    print(f\"An unexpected error occurred: {str(e)}\")\n","children":["$","$L4",null,{"className":"language-python","children":"$8"}],"title":"Python"}],["$","$L3",null,{"language":"javascript","code":"try {\n  const session = await facesign.sessions.create({\n    mode: 'redirect',\n    success_url: 'https://example.com/success',\n    cancel_url: 'https://example.com/cancel',\n  });\n} catch (error) {\n  switch (error.type) {\n    case 'FaceSignInvalidRequestError':\n      // Invalid parameters\n      console.error(`Invalid parameter: ${error.param}`);\n      break;\n    case 'FaceSignAuthenticationError':\n      // Authentication failed\n      console.error('Check your API key');\n      break;\n    case 'FaceSignRateLimitError':\n      // Rate limited\n      console.error('Rate limited. Retry after:', error.headers['retry-after']);\n      break;\n    default:\n      // Other errors\n      console.error('An error occurred:', error.message);\n  }\n}\n","children":["$","$L4",null,{"className":"language-javascript","children":"$9"}],"title":"JavaScript"}]]}],"\n",["$","$L2",null,{"level":2,"id":"common-errors-and-solutions","children":"Common errors and solutions"}],"\n",["$","h3",null,{"children":"Authentication errors"}],"\n",["$","$L3",null,{"language":"json","code":"{\n  \"error\": {\n    \"type\": \"authentication_error\",\n    \"message\": \"Invalid API key provided.\",\n    \"code\": \"invalid_api_key\"\n  }\n}\n","children":["$","$L4",null,{"className":"language-json","children":"$a"}],"title":"Invalid API key"}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Solution"}],": Check that you're using the correct API key and that it hasn't been revoked."]}],"\n",["$","h3",null,{"children":"Invalid request errors"}],"\n",["$","$L3",null,{"language":"json","code":"{\n  \"error\": {\n    \"type\": \"invalid_request_error\",\n    \"message\": \"The 'success_url' parameter is required.\",\n    \"param\": \"success_url\",\n    \"code\": \"parameter_missing\"\n  }\n}\n","children":["$","$L4",null,{"className":"language-json","children":"$b"}],"title":"Missing required parameter"}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Solution"}],": Ensure all required parameters are included in your request."]}],"\n",["$","h3",null,{"children":"Rate limit errors"}],"\n",["$","$L3",null,{"language":"json","code":"{\n  \"error\": {\n    \"type\": \"rate_limit_error\",\n    \"message\": \"Too many requests. Please retry after 60 seconds.\",\n    \"code\": \"rate_limit_exceeded\"\n  }\n}\n","children":["$","$L4",null,{"className":"language-json","children":"$c"}],"title":"Rate limit exceeded"}],"\n",["$","p",null,{"language":"txt","children":[["$","strong",null,{"children":"Solution"}],": Implement exponential backoff and respect the ",["$","$L4",null,{"children":"Retry-After"}]," header."]}],"\n",["$","$L2",null,{"level":2,"id":"implementing-retry-logic","children":"Implementing retry logic"}],"\n",["$","p",null,{"children":"For transient errors and rate limiting, implement exponential backoff:"}],"\n",["$","$L6",null,{"title":"Retry with exponential backoff","children":[["$","$L3",null,{"language":"typescript","code":"async function createSessionWithRetry(params: any, maxRetries = 3) {\n  let lastError;\n  \n  for (let i = 0; i < maxRetries; i++) {\n    try {\n      return await facesign.sessions.create(params);\n    } catch (error) {\n      lastError = error;\n      \n      // Don't retry client errors (4xx) except rate limits\n      if (error.statusCode >= 400 && error.statusCode < 500 && error.statusCode !== 429) {\n        throw error;\n      }\n      \n      // Calculate delay with exponential backoff\n      const delay = Math.min(1000 * Math.pow(2, i), 10000);\n      \n      // Use Retry-After header if available\n      if (error.headers && error.headers['retry-after']) {\n        const retryAfter = parseInt(error.headers['retry-after']) * 1000;\n        await new Promise(resolve => setTimeout(resolve, retryAfter));\n      } else {\n        await new Promise(resolve => setTimeout(resolve, delay));\n      }\n    }\n  }\n  \n  throw lastError;\n}\n","children":["$","$L4",null,{"className":"language-typescript","children":"$d"}],"title":"TypeScript"}],["$","$L3",null,{"language":"python","code":"import time\nimport random\n\ndef create_session_with_retry(params, max_retries=3):\n    last_error = None\n    \n    for i in range(max_retries):\n        try:\n            return facesign.Session.create(**params)\n        except Exception as error:\n            last_error = error\n            \n            # Don't retry client errors (4xx) except rate limits\n            if hasattr(error, 'http_status'):\n                if 400 <= error.http_status < 500 and error.http_status != 429:\n                    raise\n            \n            # Calculate delay with exponential backoff\n            delay = min(1 * (2 ** i), 10)\n            \n            # Use Retry-After header if available\n            if hasattr(error, 'headers') and 'retry-after' in error.headers:\n                time.sleep(int(error.headers['retry-after']))\n            else:\n                # Add jitter to prevent thundering herd\n                time.sleep(delay + random.uniform(0, 0.1))\n    \n    raise last_error\n","children":["$","$L4",null,{"className":"language-python","children":"$e"}],"title":"Python"}]]}],"\n",["$","$L2",null,{"level":2,"id":"idempotency","children":"Idempotency"}],"\n",["$","p",null,{"children":"To safely retry requests without accidentally performing the same operation twice, use idempotency keys:"}],"\n",["$","$L6",null,{"title":"Using idempotency keys","children":[["$","$L3",null,{"language":"typescript","code":"const session = await facesign.sessions.create({\n  mode: 'redirect',\n  success_url: 'https://example.com/success',\n  cancel_url: 'https://example.com/cancel',\n}, {\n  idempotencyKey: 'unique-key-for-this-request',\n});\n","children":["$","$L4",null,{"className":"language-typescript","children":"$f"}],"title":"TypeScript"}],["$","$L3",null,{"language":"python","code":"session = facesign.Session.create(\n    mode='redirect',\n    success_url='https://example.com/success',\n    cancel_url='https://example.com/cancel',\n    idempotency_key='unique-key-for-this-request'\n)\n","children":["$","$L4",null,{"clas