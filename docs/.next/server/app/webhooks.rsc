<span></span>0:["KA-Yc50KkfR9OgjuhdsiI",[[["",{"children":["webhooks",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["webhooks",{"children":["__PAGE__",{},[["$L1",["$","article",null,{"className":"flex h-full flex-col pt-16 pb-10","children":["$","div",null,{"className":"flex-auto prose dark:prose-invert [html_:where(&>*)]:mx-auto [html_:where(&>*)]:max-w-2xl lg:[html_:where(&>*)]:mx-[calc(50%-min(50%,var(--container-lg)))] lg:[html_:where(&>*)]:max-w-3xl","children":[["$","h1",null,{"children":"Webhooks"}],"\n",["$","p",null,{"children":"Webhooks allow you to receive real-time HTTP notifications when events happen in your FaceSign account. Rather than polling the API for updates, webhooks push data to your endpoint as soon as an event occurs.","className":"lead"}],"\n",["$","$L2",null,{"level":2,"id":"setting-up-webhooks","children":"Setting up webhooks"}],"\n",["$","p",null,{"children":"To start receiving webhooks:"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":"Create an endpoint on your server to receive webhook events"}],"\n",["$","li",null,{"children":"Register your endpoint URL in the FaceSign Dashboard"}],"\n",["$","li",null,{"children":"Handle incoming webhook events in your application"}],"\n"]}],"\n",["$","h3",null,{"children":"Creating a webhook endpoint"}],"\n",["$","p",null,{"children":"Your webhook endpoint should:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Accept POST requests with JSON payloads"}],"\n",["$","li",null,{"children":"Respond quickly with a 2xx status code"}],"\n",["$","li",null,{"children":"Verify the webhook signature for security"}],"\n"]}],"\n",["$","$L3",null,{"title":"Basic webhook handler","children":[["$","$L4",null,{"language":"typescript","code":"import express from 'express';\nimport crypto from 'crypto';\n\nconst app = express();\n\n// Important: Use raw body for signature verification\napp.post('/webhooks/facesign', \n  express.raw({ type: 'application/json' }), \n  (req, res) => {\n    const signature = req.headers['facesign-signature'];\n    const body = req.body;\n    \n    // Verify signature (see below)\n    if (!verifySignature(body, signature, webhookSecret)) {\n      return res.status(400).send('Invalid signature');\n    }\n    \n    const event = JSON.parse(body);\n    \n    // Handle the event\n    switch (event.type) {\n      case 'session.verified':\n        console.log('Session verified:', event.data.id);\n        break;\n      case 'session.failed':\n        console.log('Session failed:', event.data.id);\n        break;\n      // ... handle other event types\n    }\n    \n    // Return 200 to acknowledge receipt\n    res.status(200).send('OK');\n  }\n);\n","children":["$","$L5",null,{"className":"language-typescript","children":"$6"}],"title":"TypeScript"}],["$","$L4",null,{"language":"python","code":"from flask import Flask, request, abort\nimport json\nimport hmac\nimport hashlib\n\napp = Flask(__name__)\n\n@app.route('/webhooks/facesign', methods=['POST'])\ndef handle_webhook():\n    # Get the signature from headers\n    signature = request.headers.get('FaceSign-Signature')\n    \n    # Verify signature\n    if not verify_signature(request.data, signature, webhook_secret):\n        abort(400, 'Invalid signature')\n    \n    # Parse the event\n    event = json.loads(request.data)\n    \n    # Handle the event\n    if event['type'] == 'session.verified':\n        print(f\"Session verified: {event['data']['id']}\")\n    elif event['type'] == 'session.failed':\n        print(f\"Session failed: {event['data']['id']}\")\n    # ... handle other event types\n    \n    # Return 200 to acknowledge receipt\n    return '', 200\n","children":["$","$L5",null,{"className":"language-python","children":"$7"}],"title":"Python"}]]}],"\n",["$","$L2",null,{"level":2,"id":"webhook-events","children":"Webhook events"}],"\n",["$","p",null,{"children":"FaceSign sends the following webhook events:"}],"\n",["$","h3",