<span></span>e:T80d,from flask import Flask, request, abort
import json
import hmac
import hashlib
from datetime import datetime

app = Flask(__name__)
webhook_secret = os.environ.get('FACESIGN_WEBHOOK_SECRET')

@app.route('/webhooks/facesign', methods=['POST'])
def handle_webhook():
    # Get signature
    signature = request.headers.get('FaceSign-Signature')
    
    # Verify signature
    if not verify_signature(request.data, signature, webhook_secret):
        abort(400, 'Invalid signature')
    
    event = json.loads(request.data)
    
    # Prevent duplicate processing
    if is_event_processed(event['id']):
        return '', 200
    
    try:
        # Handle different event types
        if event['type'] == 'session.created':
            handle_session_created(event['data'])
            
        elif event['type'] == 'session.verified':
            handle_session_verified(event['data'])
            
        elif event['type'] == 'session.failed':
            handle_session_failed(event['data'])
            
        elif event['type'] == 'session.cancelled':
            handle_session_cancelled(event['data'])
            
        else:
            print(f"Unhandled event type: {event['type']}")
        
        # Mark event as processed
        mark_event_processed(event['id'])
        
        return '', 200
        
    except Exception as e:
        print(f"Webhook processing error: {e}")
        abort(500)

def handle_session_verified(session):
    # Update user verification status
    update_user_verification_status(
        session['metadata']['user_id'],
        {
            'verified': True,
            'verified_at': datetime.now(),
            'verification_data': session['verified_outputs']
        }
    )
    
    # Send confirmation email
    send_verification_success_email(session['metadata']['user_id'])

def handle_session_failed(session):
    # Log failure
    print(f"Verification failed for user {session['metadata']['user_id']}")
    
    # Notify user
    send_verification_failed_email(session['metadata']['user_id'])
