<span></span>b:T56d,import ai.facesign.sdk.FaceSign
import ai.facesign.sdk.FaceSignConfig
import ai.facesign.sdk.FaceSignDelegate

class VerificationActivity : AppCompatActivity(), FaceSignDelegate {
    
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        startVerification()
    }
    
    private fun startVerification() {
        // Get client secret from your backend
        apiClient.createSession { result ->
            when (result) {
                is Result.Success -> {
                    val config = FaceSignConfig(
                        clientSecret = result.data.clientSecret,
                        delegate = this
                    )
                    
                    FaceSign.startVerification(this, config)
                }
                is Result.Error -> {
                    Log.e("FaceSign", "Failed to get client secret", result.exception)
                }
            }
        }
    }
    
    override fun onVerificationCompleted(session: FaceSignSession) {
        if (session.report.isVerified) {
            // Verification successful
            navigateToDashboard()
        } else {
            // Verification failed
            showErrorDialog("Verification failed")
        }
    }
    
    override fun onVerificationCancelled() {
        // User cancelled verification
        finish()
    }
}
