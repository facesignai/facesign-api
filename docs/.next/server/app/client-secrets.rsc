{"language":"javascript","code":"import FaceSign from '@facesign/js';\n\n// Initialize with client secret\nconst facesign = new FaceSign({\n  clientSecret: clientSecret, // From your backend\n});\n\n// Mount the verification interface\nfacesign.mount('#verification-container');\n\n// Listen for completion\nfacesign.on('session.completed', (session) => {\n  if (session.report.isVerified) {\n    // Verification successful\n    window.location.href = '/dashboard';\n  } else {\n    // Verification failed\n    showErrorMessage('Verification failed. Please try again.');\n  }\n});\n","children":["$","$L5",null,{"className":"language-javascript","children":"$7"}],"title":"JavaScript SDK"}],["$","$L4",null,{"language":"typescript","code":"import { FaceSignProvider, useFaceSign } from '@facesign/react';\n\nfunction VerificationPage({ clientSecret }: { clientSecret: string }) {\n  return (\n    <FaceSignProvider clientSecret={clientSecret}>\n      <VerificationComponent />\n    </FaceSignProvider>\n  );\n}\n\nfunction VerificationComponent() {\n  const { mount, session } = useFaceSign();\n  \n  useEffect(() => {\n    mount('#verification-container');\n  }, [mount]);\n  \n  useEffect(() => {\n    if (session?.status === 'complete') {\n      if (session.report?.isVerified) {\n        router.push('/dashboard');\n      } else {\n        setError('Verification failed');\n      }\n    }\n  }, [session]);\n  \n  return <div id=\"verification-container\" />;\n}\n","children":["$","$L5",null,{"className":"language-typescript","children":"$8"}],"title":"React integration"}]]}],"\n",["$","h3",null,{"children":"Mobile integration"}],"\n",["$","p",null,{"children":"For mobile applications, use the native SDKs:"}],"\n",["$","$L3",null,{"title":"Mobile integration","children":[["$","$L4",null,{"language":"swift","code":"$9","children":["$","$L5",null,{"className":"language-swift","children":"$a"}],"title":"iOS (Swift)"}],["$","$L4",null,{"language":"kotlin","code":"$b","children":["$","$L5",null,{"className":"language-kotlin","children":"$c"}],"title":"Android (Kotlin)"}],["$","$L4",null,{"language":"dart","code":"$d","children":["$","$L5",null,{"className":"language-dart","children":"$e"}],"title":"Flutter"}]]}],"\n",["$","hr",null,{}],"\n",["$","$L2",null,{"level":2,"id":"security-considerations","children":"Security considerations"}],"\n",["$","h3",null,{"children":"Client secrets are safe for frontend use"}],"\n",["$","p",null,{"children":"Unlike API keys, client secrets are designed to be safe for client-side use:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Session-specific"}]," - Each client secret is tied to a single session"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Time-limited"}]," - Automatically expire after 1 hour"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Read-only"}]," - Cannot be used to create new sessions or access other data"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Domain-restricted"}]," - Can be restricted to specific domains (contact support)"]}],"\n"]}],"\n",["$","h3",null,{"children":"Best practices"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Fetch on demand"}]," - Get client secrets from your backend when needed"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Handle expiration"}]," - Refresh client secrets if they expire during verification"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Secure transmission"}]," - Always use HTTPS when transmitting client secrets"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Don't store long-term"}]," - Client secrets are meant for immediate use"]}],"\n"]}],"\n",["$","$L3",null,{"title":"Secure implementation","children":[["$","$L4",null,{"language":"typescript","code":"$f","children":["$","$L5",null,{"className":"language-typescript","children":"$10"}],"title":"Backend endpoint"}],["$","$L4",null,{"language":"typescript","code":"async function startVerification() {\n  try {\n    // Fetch client secret from your secure backend\n    const response = await fetch('/api/create-verification', {\n      method: 'POST',\n      headers: {\n        'Authorization': `Bearer ${userToken}`,\n        'Content-Type': 'application/json'\n      }\n    });\n    \n    if (!response.ok) {\n      throw new Error('Failed to create verification session');\n    }\n    \n    const { clientSecret, sessionId } = await response.json();\n    \n    // Use client secret with FaceSign SDK\n    const facesign = new FaceSign({\n      clientSecret: clientSecret\n    });\n    \n    await facesign.mount('#verification-container');\n    \n  } catch (error) {\n    console.error('Verification startup failed:', error);\n    showErrorMessage('Unable to start verification');\n  }\n}\n","children":["$","$L5",null,{"className":"language-typescript","children":"$11"}],"title":"Frontend implementation"}]]}],"\n",["$","h3",null,{"children":"Handling expiration"}],"\n",["$","p",null,{"children":"Client secrets expire after 1 hour. If verification takes longer or you need to restart the process:"}],"\n",["$","$L4",null,{"language":"typescript","code":"$12","children":["$","$L5",null,{"className":"language-typescript","children":"$13"}],"title":"Handle expiration"}],"\n",["$","$L2",null,{"level":2,"id":"next-steps","children":"Next steps"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","$L14",null,{"href":"/sessions","children":"Sessions"}]," - Learn about the session lifecycle"]}],"\n",["$","li",null,{"children":[["$","$L14",null,{"href":"/webhooks","children":"Webhooks"}]," - Get real-time updates about verification progress"]}],"\n",["$","li",null,{"children":[["$","$L14",null,{"href":"/modules","children":"Modules"}]," - Configure verification modules for your use case"]}],"\n"]}]]}]}],null],null],null]},[null,["$","$L15",n