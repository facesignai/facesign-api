ll,{"language":"typescript","code":"import { FaceSign } from '@facesign/sdk';\n\nconst facesign = new FaceSign({\n  apiKey: process.env.FACESIGN_API_KEY,\n});\n\nconst session = await facesign.sessions.create({\n  mode: 'redirect',\n  success_url: 'https://example.com/success',\n  cancel_url: 'https://example.com/cancel',\n  metadata: {\n    user_id: '123456',\n  },\n});\n\nconsole.log(session.url); // Redirect your user to this URL\n","children":["$","$L3",null,{"className":"language-typescript","children":"$6"}],"title":"TypeScript"}],["$","$L5",null,{"language":"python","code":"import facesign\nimport os\n\nfacesign.api_key = os.environ.get('FACESIGN_API_KEY')\n\nsession = facesign.Session.create(\n    mode='redirect',\n    success_url='https://example.com/success',\n    cancel_url='https://example.com/cancel',\n    metadata={\n        'user_id': '123456'\n    }\n)\n\nprint(session.url)  # Redirect your user to this URL\n","children":["$","$L3",null,{"className":"language-python","children":"$7"}],"title":"Python"}],["$","$L5",null,{"language":"bash","code":"curl https://api.facesign.ai/v1/sessions \\\n  -H \"Authorization: Bearer sk_test_...\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"mode\": \"redirect\",\n    \"success_url\": \"https://example.com/success\",\n    \"cancel_url\": \"https://example.com/cancel\",\n    \"metadata\": {\n      \"user_id\": \"123456\"\n    }\n  }'\n","children":["$","$L3",null,{"className":"language-bash","children":"$8"}],"title":"cURL"}]]}],"\n",["$","$L2",null,{"level":2,"id":"redirect-your-user","children":"Redirect your user"}],"\n",["$","p",null,{"language":"txt","children":["After creating a session, you'll receive a response with a ",["$","$L3",null,{"children":"url"}]," field. Redirect your user to this URL to start the verification process:"]}],"\n",["$","$L5",null,{"language":"json","code":"{\n  \"id\": \"vs_1a2b3c4d5e6f\",\n  \"object\": \"verification_session\",\n  \"client_secret\": \"vs_1a2b3c4d5e6f_secret_abc123\",\n  \"url\": \"https://verify.facesign.ai/s/vs_1a2b3c4d5e6f\",\n  \"status\": \"pending\",\n  \"mode\": \"redirect\",\n  \"success_url\": \"https://example.com/success\",\n  \"cancel_url\": \"https://example.com/cancel\",\n  \"metadata\": {\n    \"user_id\": \"123456\"\n  },\n  \"created\": 1234567890,\n  \"expires\": 1234571490\n}\n","children":["$","$L3",null,{"className":"language-json","children":"$9"}],"title":"Response"}],"\n",["$","$L2",null,{"level":2,"id":"handle-the-result","children":"Handle the result"}],"\n",["$","p",null,{"language":"txt","children":["After the user completes or cancels the verification, they'll be redirected to your ",["$","$L3",null,{"children":"success_url"}]," or ",["$","$L3",null,{"children":"cancel_url"}]," with the session ID as a query parameter:"]}],"\n",["$","$L5",null,{"language":"txt","code":"https://example.com/success?session_id=vs_1a2b3c4d5e6f\n","children":["$","$L3",null,{"children":"<span><span style=\"color: undefined\">https://example.com/success?session_id=vs_1a2b3c4d5e6f</span></span>\n<span><span style=\"color: undefined\"></span></span>"}]}],"\n",["$","p",null,{"children":"You can then retrieve the session to check the verification status:"}],"\n",["$","$L4",null,{"title":"Retrieve a session","tag":"GET","label":"/v1/sessions/:id","children":[["$","$L5",null,{"language":"typescript","code":"const session = await facesign.sessions.retrieve('vs_1a2b3c4d5e6f');\n\nif (session.status === 'verified') {\n  // User successfully verified their identity\n  console.log('Verification successful!');\n  console.log('Verified data:', session.verified_outputs);\n} else if (session.status === 'failed') {\n  // Verification failed\n  console.log('Verification failed');\n}\n","children":["$","$L3",null,{"className":"language-typescript","children":"$a"}],"title":"TypeScript"}],["$","$L5",null,{"language":"python","code":"session = facesign.Session.retrieve('vs_1a2b3c4d5e6f')\n\nif session.status == 'verified':\n    # User successfully verified their identity\n    print('Verification successful!')\n    print('Verified data:', session.verified_outputs)\nelif session.status == 'failed':\n    # Verification failed\n    print('Verification failed')\n","children":["$","$L3",null,{"className":"language-python","children":"$b"}],"title":"Python"}],["$","$L5",null,{"language":"bash","code":"curl https://api.facesign.ai/v1/sessions/vs_1a2b3c4d5e6f \\\n  -H \"Authorization: Bearer sk_test_...\"\n","children":["$","$L3",null,{"className":"language-bash","children":"<span><span style=\"color: var(--shiki-token-function)\">curl</span><span style=\"color: var(--shiki-color-text)\"> </span><span style=\"color: var(--shiki-token-string)\">https://api.facesign.ai/v1/sessions/vs_1a2b3c4d5e6f</span><span style=\"color: var(--shiki-color-text)\"> \\</span></span>\n<span><span style=\"color: var(--shiki-color-text)\">  </span><span style=\"color: var(--shiki-token-string)\">-H</span><span style=\"color: var(--shiki-color-text)\"> </span><span style=\"color: var(--shiki-token-string-expression)\">&quot;Authorization: Bearer sk_test_...&quot;</span></span>\n<span></span>"}],"title":"cURL"}]]}],"\n",["$","$L2",null,{"level":2,"id":"whats-next","children":"What's next?"}],"\n",["$","p",null,{"children":"Congratulations! You've created your first verification session. Here are some next steps:"}],"\n",["$","div",null,{"className":"not-prose mt-6 flex flex-col gap-3","children":[["$","$Lc",null,{"className":"inline-flex gap-0.5 justify-center overflow-hidden text-sm font-medium transition text-emerald-500 hover:text-emerald-600 dark:text-emerald-400 dark:hover:text-emerald-500","href":"/sessions","children":[false,["$","p",null,{"children":"Learn more about sessions"}],["$","svg",null,{"viewBox":"0 0 20 20","fill":"none","aria-hidden":"true","className":"mt-0.5 h-5 w-5 relative top-px -mr-1","children":["$","path",null,{"stroke":"currentColor","strokeLinecap":"round","strokeLinejoin":"round","d":"m11