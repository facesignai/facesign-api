Secret } = await client.sessions.create({\n  clientReferenceId: 'user_123',\n  langs: ['en', 'es', 'fr'], // Available languages for this session\n  defaultLang: 'en', // Default language if user's preference isn't available\n  modules: [{ type: 'identityVerification' }]\n});\n","children":["$","$L2",null,{"className":"language-typescript","children":"$9"}],"title":"Configure session languages"}],"\n",["$","h3",null,{"children":"Dynamic language selection"}],"\n",["$","p",null,{"children":"You can dynamically select languages based on user preferences or browser settings:"}],"\n",["$","$L5",null,{"language":"typescript","code":"$a","children":["$","$L2",null,{"className":"language-typescript","children":"$b"}],"title":"Dynamic language selection"}],"\n",["$","h3",null,{"children":"Regional considerations"}],"\n",["$","p",null,{"children":"Consider your target markets when selecting languages:"}],"\n",["$","$L5",null,{"language":"typescript","code":"const REGIONAL_LANGUAGES = {\n  'north-america': ['en', 'es', 'fr'],\n  'europe': ['en', 'de', 'fr', 'it', 'es', 'nl', 'pl'],\n  'asia-pacific': ['en', 'ja', 'ko', 'zh-CN', 'zh-TW'],\n  'latin-america': ['es', 'pt', 'en'],\n  'global': ['en', 'es', 'fr', 'de', 'it', 'pt', 'nl', 'pl', 'ru', 'ja', 'ko', 'zh-CN', 'zh-TW']\n};\n\nasync function createRegionalSession(userId: string, region: string) {\n  const languages = REGIONAL_LANGUAGES[region] || REGIONAL_LANGUAGES['global'];\n  \n  const { session, clientSecret } = await client.sessions.create({\n    clientReferenceId: userId,\n    langs: languages,\n    defaultLang: languages[0], // First language as default\n    modules: [{ type: 'identityVerification' }]\n  });\n  \n  return { session, clientSecret };\n}\n","children":["$","$L2",null,{"className":"language-typescript","children":"$c"}],"title":"Regional language configuration"}],"\n",["$","$L3",null,{"level":2,"id":"language-selection-ux","children":"Language selection UX"}],"\n",["$","h3",null,{"children":"Let users choose their language"}],"\n",["$","p",null,{"children":"Provide a language selector in your frontend before starting verification:"}],"\n",["$","$L5",null,{"language":"typescript","code":"$d","children":["$","$L2",null,{"className":"language-typescript","children":"$e"}],"title":"Language selector component"}],"\n",["$","h3",null,{"children":"Auto-detect user language"}],"\n",["$","p",null,{"children":"Automatically detect and use the user's browser language:"}],"\n",["$","$L5",null,{"language":"typescript","code":"function detectUserLanguage(): string {\n  // Get browser language\n  const browserLang = navigator.language.split('-')[0]; // e.g., 'en' from 'en-US'\n  \n  // List of supported languages (you'd get this from the API)\n  const supportedLanguages = ['en', 'es', 'fr', 'de', 'it', 'pt', 'nl', 'pl', 'ru', 'ja', 'ko', 'zh'];\n  \n  // Return detected language if supported, otherwise default to English\n  return supportedLanguages.includes(browserLang) ? browserLang : 'en';\n}\n\nasync function createAutoLocalizedSession(userId: string) {\n  const detectedLanguage = detectUserLanguage();\n  \n  const { session, clientSecret } = await client.sessions.create({\n    clientReferenceId: userId,\n    langs: [detectedLanguage, 'en'], // Include English as fallback\n    defaultLang: detectedLanguage,\n    modules: [{ type: 'identityVerification' }]\n  });\n  \n  return { session, clientSecret };\n}\n","children":["$","$L2",null,{"className":"language-typescript","children":"$f"}],"title":"Auto-detect language"}],"\n",["$","$L3",null,{"level":2,"id":"best-practices","children":"Best practices"}],"\n",["$","h3",null,{"children":"1. Cache language list"}],"\n",["$","p",null,{"children":"Cache the languages list to avoid unnecessary API calls:"}],"\n",["$","$L5",null,{"language":"typescript","code":"let cachedLanguages: Language[] | null = null;\nlet cacheTimestamp = 0;\nconst CACHE_DURATION = 24 * 60 * 60 * 1000; // 24 hours\n\nasync function getAvailableLanguages(): Promise<Language[]> {\n  const now = Date.now();\n  \n  // Return cached version if still valid\n  if (cachedLanguages && (now - cacheTimestamp) < CACHE_DURATION) {\n    return cachedLanguages;\n  }\n  \n  // Fetch fresh data\n  const { langs } = await client.languages.list();\n  cachedLanguages = langs;\n  cacheTimestamp = now;\n  \n  return langs;\n}\n","children":["$","$L2",null,{"className":"language-typescript","children":"$10"}],"title":"Cache languages"}],"\n",["$","h3",null,{"children":"2. Provide language fallbacks"}],"\n",["$","p",null,{"children":"Always include common languages as fallbacks:"}],"\n",["$","$L5",null,{"language":"typescript","code":"function getLanguagesWithFallback(userPreferences: string[]): string[] {\n  const fallbackLanguages = ['en', 'es']; // English and Spanish as common fallbacks\n  \n  // Combine user preferences with fallbacks, removing duplicates\n  return [...new Set([...userPreferences, ...fallbackLanguages])];\n}\n","children":["$","$L2",null,{"className":"language-typescript","children":"$11"}],"title":"Language fallbacks"}],"\n",["$","h3",null,{"children":"3. Handle RTL languages"}],"\n",["$","p",null,{"children":"For right-to-left languages, ensure your UI adapts accordingly:"}],"\n",["$","$L5",null,{"language":"typescript","code":"const RTL_LANGUAGES = ['ar', 'he', 'fa', 'ur'];\n\nfunction isRTLLanguage(langId: string): boolean {\n  return RTL_LANGUAGES.includes(langId);\n}\n\n// Apply RTL styling\nfunction applyLanguageDirection(langId: string) {\n  const isRTL = isRTLLanguage(langId);\n  document.dir = isRTL ? 'rtl' : 'ltr';\n  document.documentElement.lang = langId;\n}\n","children":["$","$L2",null,{"className":"language-typescript","children":"$12"}],"title":"RTL language support"}],"\n",["$","h3",null,{"children":"4. Store user language preference"}],"\n",["$","p",null,{"children":"Remember user language choices for future sessions:"}],"\n",["$","$L5",null,{"language":"typescript","code":"async function updateUserLanguagePreference(userId: string, langId: string) {\n  await db.users.update({\n    where: { id: userId },\n    data: { preferredLanguage: langId }\n  });\n  \n  // Also store in localStorage for immediate use\n  localStorage.setItem('preferredLanguage', langId);\n}\n\nfunction getUserLanguagePreference(userId?: string): string {\n  // Try localStorage first for immediate access\n  const storedLang = localStorage.getItem('preferredLanguage');\n  if (storedLang) return storedLang;\n  \n  // Fall back to browser language\n  return detectUserLanguage();\n}\n","children":["$","$L2",null,{"className":"language-typescript","children":"$13"}],"title":"Store language preference"}],"\n",["$","$L3",null,{"level":2,"id":"next-steps","children":"Next steps"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","$L14",null,{"href":"/sessions","children":"Sessions"}]," - Learn how to create sessions with language configuration"]}],"\n",["$","li",null,{"children":[["$","$L14",null,{"href":"/avatars","children":"Avatars"}]," - Discover available AI avatars for different languages"]}],"\n",["$","li",null,{"children":[["$","$L14",null,{"href":"/modules","children":"Modules"}]," - Configure verification modules for specific regions"]}],"\n"]}]]}]}],null],null],null]},[null,["$","$L15",null,{"parallelRouterKey":"children","segmentPath":["children","languages","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L16",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/93d5a4b3ee791a1d.css","precedence":"next","crossOrigin":"$undefined"}]],"$L17"],null],null],["$L18",null]]]]
