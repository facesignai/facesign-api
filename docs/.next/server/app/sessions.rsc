on] --> B[requiresInput]\n    B --> C[User Starts Flow]\n    C --> D[processing]\n    D --> E{Verification}\n    E -->|Success| F[complete]\n    E -->|Failure| G[complete]\n    E -->|User Exits| H[canceled]\n","children":["$","$L6",null,{"className":"language-mermaid","children":"$15"}]}],"\n",["$","h3",null,{"children":"Session statuses"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"language":"txt","children":["$","$L6",null,{"children":"requiresInput"}]}]," - Session created, waiting for user to begin verification"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"language":"txt","children":["$","$L6",null,{"children":"processing"}]}]," - User is actively going through the verification flow"]}],"\n",["$","li",null,{"language":"txt","children":[["$","strong",null,{"language":"txt","children":["$","$L6",null,{"children":"complete"}]}]," - Verification finished (check ",["$","$L6",null,{"children":"report.isVerified"}]," for success/failure)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"language":"txt","children":["$","$L6",null,{"children":"canceled"}]}]," - Session was cancelled by user or expired"]}],"\n"]}],"\n",["$","h3",null,{"children":"Handling results with webhooks"}],"\n",["$","p",null,{"children":"The recommended approach is to use webhooks to get real-time updates about session status changes:"}],"\n",["$","$L5",null,{"language":"typescript","code":"app.post('/webhooks/facesign', async (req, res) => {\n  const { type, data } = req.body;\n  \n  if (type === 'session.completed') {\n    const session = data.session;\n    \n    // Update your database\n    await db.verifications.update({\n      where: { sessionId: session.id },\n      data: {\n        status: session.status,\n        finishedAt: new Date(session.finishedAt * 1000),\n        isVerified: session.report?.isVerified || false,\n        extractedData: session.report?.extractedData || {}\n      }\n    });\n    \n    // Trigger your business logic\n    if (session.report?.isVerified) {\n      await approveUserAccount(session.settings.clientReferenceId);\n      await sendWelcomeEmail(session.settings.clientReferenceId);\n    } else {\n      await flagUserForReview(session.settings.clientReferenceId);\n    }\n  }\n  \n  res.status(200).send('OK');\n});\n","children":["$","$L6",null,{"className":"language-typescript","children":"$16"}],"title":"Webhook handler"}],"\n",["$","$L2",null,{"level":2,"id":"integration-best-practices","children":"Integration best practices"}],"\n",["$","h3",null,{"children":"1. Database-First Approach"}],"\n",["$","p",null,{"children":"Store session data in your database immediately after creation:"}],"\n",["$","$L5",null,{"language":"typescript","code":"// Create session and store in your DB\nconst { session, clientSecret } = await client.sessions.create(config);\n\nawait db.verifications.create({\n  id: generateId(),\n  sessionId: session.id,\n  userId: userId,\n  status: session.status,\n  clientReferenceId: session.settings.clientReferenceId,\n  createdAt: new Date(session.createdAt * 1000),\n  metadata: session.settings.metadata\n});\n\n// Return client secret to frontend\nreturn { clientSecret: clientSecret.secret };\n","children":["$","$L6",null,{"className":"language-typescript","children":"$17"}]}],"\n",["$","h3",null,{"children":"2. Use Webhooks for Real-Time Updates"}],"\n",["$","p",null,{"children":"Don't poll the API for session updates. Use webhooks instead:"}],"\n",["$","$L5",null,{"language":"typescript","code":"// ❌ Don't do this - polling is slow and inefficient\nsetInterval(async () => {\n  const { session } = await client.sessions.retrieve(sessionId);\n  updateDatabase(session);\n}, 5000);\n\n// ✅ Do this - use webhooks for real-time updates\napp.post('/webhooks/facesign', handleWebhook);\n","children":["$","$L6",null,{"className":"language-typescript","children":"$18"}]}],"\n",["$","h3",null,{"children":"3. Handle Client Secret Expiration"}],"\n",["$","p",null,{"children":"Client secrets expire after 1 hour. Handle expiration gracefully:"}],"\n",["$","$L5",null,{"language":"typescript","code":"async function getValidClientSecret(sessionId: string) {\n  const session = await db.verifications.findUnique({\n    where: { sessionId }\n  });\n  \n  if (!session.clientSecret || isExpired(session.clientSecretExpiry)) {\n    const { clientSecret } = await client.sessions.refreshSecret(sessionId);\n    \n    await db.verifications.update({\n      where: { sessionId },\n      data: {\n        clientSecret: clientSecret.secret,\n        clientSecretExpiry: new Date(clientSecret.expireAt * 1000)\n      }\n    });\n    \n    return clientSecret.secret;\n  }\n  \n  return session.clientSecret;\n}\n","children":["$","$L6",null,{"className":"language-typescript","children":"$19"}]}],"\n",["$","h3",null,{"children":"4. Link Sessions to Your Users"}],"\n",["$","p",null,{"language":"txt","children":["Always use ",["$","$L6",null,{"children":"clientReferenceId"}]," to link sessions to your users:"]}],"\n",["$","$L5",null,{"language":"typescript","code":"const { session, clientSecret } = await client.sessions.create({\n  clientReferenceId: user.id, // Your internal user ID\n  metadata: {\n    email: user.email,\n    signupDate: user.createdAt.toISOString(),\n    source: 'web_signup'\n  },\n  modules: [{ type: 'identityVerification' }]\n});\n","children":["$","$L6",null,{"className":"language-typescript","children":"$1a"}]}],"\n",["$","h3",null,{"children":"5. Build Logic on Your Database"}],"\n",["$","p",null,{"children":"Query your own database for verification status, don't call the API repeatedly:"}],"\n",["$","$L5",null,{"language":"typescript","code":"// ✅ Query your database\nasync function getUserVerificationStatus(userId: string) {\n  return await db.verifications.findFirst({\n    where: { \n      userId,\n      status: 'complete'\n    },\n    orderBy: { createdAt: 'desc' }\n  });\n}\n\n// Use in your application logic\nconst verification = await getUserVerificationStatus(userId);\nif (verification?.isVerified) {\n  // Allow access to premium features\n}\n","children":["$","$L6",null,{"className":"language-typescript","children":"$1b"}]}]]}]}],null],null],null]},[null,["$","$L1c",null,{"parallelRouterKey":"children","segmentPath":["children","sessions","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L1d",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/36fb8f8eecf75966.css","precedence":"next","crossOrigin":"$undefined"}]],"$L1e"],null],null],["$L1f",null]]]]
