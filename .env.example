# FaceSign API Configuration
# Copy this file to .env and replace with your actual API keys

# Development Environment
FACESIGN_DEV_API_KEY=your_dev_api_key_here
FACESIGN_DEV_SERVER_URL=https://api.dev.facesign.ai

# Production Environment  
FACESIGN_PROD_API_KEY=your_prod_api_key_here
FACESIGN_PROD_SERVER_URL=https://api.facesign.ai

# Instructions for Local Development:
# 1. Copy this file: cp .env.example .env
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit the .env file to version control

# Instructions for Vercel Deployment:
# Set these environment variables in your Vercel project dashboard:
# - FACESIGN_DEV_API_KEY
# - FACESIGN_PROD_API_KEY
# - FACESIGN_DEV_SERVER_URL (optional)
# - FACESIGN_PROD_SERVER_URL (optional)